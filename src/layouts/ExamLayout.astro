---
import '../styles/global.css';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full bg-slate-950 text-slate-100 select-none">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} | HSC IT Mock Simulator</title>
    <style>
      * {
        -webkit-user-select: none;
        -moz-user-select: none;
        -ms-user-select: none;
        user-select: none;
      }
    </style>
  </head>
  <body class="min-h-screen bg-slate-950 font-sans relative overflow-x-hidden" oncontextmenu="return false;">
    <div class="pointer-events-none fixed inset-0 z-50 flex flex-wrap items-center justify-around opacity-[0.03] text-sm font-mono text-slate-100">
      {Array.from({ length: 24 }).map(() => (
        <span class="p-8 transform -rotate-12">HSC IT CODE 97 • SIMULATOR</span>
      ))}
    </div>

    <header class="h-16 border-b border-slate-800 bg-slate-900/90 px-6 flex items-center justify-between sticky top-0 z-40 backdrop-blur">
      <div class="flex items-center gap-3">
        <span class="px-2.5 py-1 rounded bg-emerald-600 font-mono text-xs font-bold text-white">CODE 97</span>
        <h1 class="text-sm md:text-base font-bold text-slate-100">HSC Class 12 IT — 80-Mark Mock Simulator</h1>
      </div>
      <div id="exam-timer" class="px-3 py-1 rounded-lg bg-amber-500/10 border border-amber-500/20 text-amber-400 font-mono text-sm font-semibold">
        02:30:00
      </div>
    </header>

    <main class="max-w-6xl mx-auto p-4 md:p-6">
      <slot />
    </main>

    <script>
      document.addEventListener('keydown', (e) => {
        if (
          e.key === 'F12' ||
          (e.ctrlKey && (e.key === 'u' || e.key === 'U' || e.key === 'c' || e.key === 'C' || e.key === 's' || e.key === 'S'))
        ) {
          e.preventDefault();
        }
      });
    </script>
  </body>
</html>