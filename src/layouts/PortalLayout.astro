              </button>
              <div class="nav-dropdown-menu hidden absolute top-12 left-0 w-60 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl p-2 z-50">
                <a href="/practicals/class-12-science" class="block px-3 py-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 text-xs font-medium">Class 12 Science SOPs</a>
                <a href="/practicals/class-12-commerce" class="block px-3 py-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 text-xs font-medium">Class 12 Commerce SOPs</a>
