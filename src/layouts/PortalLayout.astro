        <!-- Mobile Route Tree -->
        <div class="space-y-4 pt-2 border-t border-slate-100 dark:border-slate-800/80 text-sm">
          <div>
            <div class="text-[11px] font-mono font-bold text-slate-400 uppercase tracking-wider mb-2">Curriculum Units</div>
            <div class="space-y-2 pl-2">
