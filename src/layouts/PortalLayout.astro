---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  keywords?: string;
}

const { 
  title, 
  description = "Maharashtra State Board & ICSE Computer Applications study portal. 80-mark computerized online mock exams, Balbharati textbook solutions, SOP practical solutions, IT MCQs with answers, and chapter notes.",
  keywords = "hsc it notes, hsc it practicals, 12th information technology notes, hsc it mock exam, 12th it textbook pdf science, 12th it textbook pdf commerce, balbharati solutions for information technology 12th standard hsc, icse computer applications class 10"
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'http://localhost:4321');
---

<!doctype html>
<html lang="en" class="h-full scroll-smooth overflow-x-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <title>{title} | HSC IT Portal</title>
    <meta name="title" content={`${title} | HSC IT Portal`} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | HSC IT Portal`} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_IN" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
    <style>
      body {
        font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
      }
      .font-mono {
        font-family: 'JetBrains Mono', monospace;
      }
      /* Hover bridge so menus don't snap shut */
      .nav-item-dropdown:hover .nav-dropdown-menu {
        display: block;
      }
    </style>
    <script is:inline>
      const savedTheme = localStorage.getItem('theme');
      if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>
  </head>
  <body class="min-h-screen bg-slate-50 dark:bg-slate-950 text-slate-900 dark:text-slate-100 flex flex-col justify-between transition-colors duration-150 antialiased overflow-x-hidden">
    
    <!-- Primary Header -->
    <header class="sticky top-0 z-50 bg-white/95 dark:bg-slate-950/95 backdrop-blur border-b border-slate-200/80 dark:border-slate-800/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-16 flex items-center justify-between gap-4">
        
        <!-- Left: Brand Identity -->
        <a href="/" class="flex items-center gap-3 shrink-0 group">
          <div class="h-10 w-10 rounded-xl bg-emerald-600 flex items-center justify-center text-white shadow-md shadow-emerald-600/30 transition group-hover:scale-105">
            <svg class="w-5 h-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 3v2m6-2v2M9 19v2m6-2v2M3 9h2m-2 6h2m14-6h2m-2 6h2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
            </svg>
          </div>
          <div>
            <div class="font-extrabold tracking-tight text-slate-900 dark:text-white text-sm leading-tight">
              HSC IT PORTAL
            </div>
            <p class="text-[10px] text-slate-500 dark:text-slate-400 font-semibold tracking-wide uppercase">
              EXAM PREP &amp; RESOURCES
            </p>
          </div>
        </a>

        <!-- Center: Primary Nav Links & Stream Switcher -->
        <div class="hidden lg:flex items-center gap-6">
          
          <!-- Stream Switcher Pill -->
          <div class="flex items-center bg-slate-100 dark:bg-slate-900 p-1 rounded-xl border border-slate-200 dark:border-slate-800 text-xs font-bold shadow-inner">
            <button 
              id="btn-stream-sci" 
              type="button"
              class="px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer font-bold"
