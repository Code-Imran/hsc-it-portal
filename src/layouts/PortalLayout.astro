              <div class="nav-dropdown-menu hidden absolute top-12 left-0 w-64 bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-800 rounded-xl shadow-xl p-2 z-50">
                <div class="text-[10px] font-mono font-bold text-slate-400 px-3 py-1 uppercase">HSC State Board</div>
                <a href="/#syllabus" class="block px-3 py-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 text-xs font-medium">Class 12 IT (Syllabus & Notes)</a>
                <a href="/class-11" class="block px-3 py-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 text-xs font-medium">Class 11 IT (Notes & Syllabus)</a>
                
                <div class="border-t border-slate-100 dark:border-slate-800 my-1"></div>
                
                <div class="text-[10px] font-mono font-bold text-slate-400 px-3 py-1 uppercase">ICSE Computer Apps</div>
                <a href="/icse/class-10" class="block px-3 py-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 text-xs font-medium">Class 10 (Java & BlueJ)</a>
                <a href="/icse/class-9" class="block px-3 py-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 text-xs font-medium">Class 9 Computer Apps</a>
                <a href="/icse/class-8" class="block px-3 py-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 text-xs font-medium">Class 8 Computer Studies</a>
              </div>
            </div>

            <!-- Practicals Dropdown -->
            <div class="relative nav-item-dropdown py-4">
              <button type="button" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition flex items-center gap-1 cursor-pointer">
                Practicals (SOP)
