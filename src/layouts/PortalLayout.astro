            </div>
          </div>

          <div>
            <div class="text-[11px] font-mono font-bold text-slate-400 uppercase tracking-wider mb-2">Downloads & Textbooks</div>
            <div class="space-y-2 pl-2">
              <a href="https://ebooks.ebalbharati.in/pdfs/1203010499.pdf" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between font-medium text-slate-700 dark:text-slate-200 hover:text-emerald-600">
                <span>12th IT Science Textbook</span>
                <span class="text-[10px] font-mono text-emerald-600 font-bold">PDF ↗</span>
              </a>
              <a href="https://ebooks.ebalbharati.in/pdfs/1203010499.pdf" target="_blank" rel="noopener noreferrer" class="flex items-center justify-between font-medium text-slate-700 dark:text-slate-200 hover:text-emerald-600">
                <span>12th IT Commerce Textbook</span>
                <span class="text-[10px] font-mono text-emerald-600 font-bold">PDF ↗</span>
              </a>
              <a href="/downloads/journal" class="block font-medium text-slate-700 dark:text-slate-200 hover:text-emerald-600">Class 12 IT Journal Specimen</a>
