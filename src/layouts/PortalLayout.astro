              <span>Science</span>
              <span class="text-[10px] opacity-80 font-mono font-normal">97</span>
            </button>
            <button 
              id="btn-stream-comm" 
              type="button"
              class="px-3 py-1.5 rounded-lg transition-all flex items-center gap-1.5 cursor-pointer font-bold"
            >
              <span>Commerce</span>
              <span class="text-[10px] opacity-80 font-mono font-normal">99</span>
            </button>
