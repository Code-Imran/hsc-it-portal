              <a href="/icse/class-10" class="block font-medium text-slate-700 dark:text-slate-200 hover:text-emerald-600">ICSE Class 10 (Java & BlueJ)</a>
            </div>
          </div>

          <div>
            <div class="text-[11px] font-mono font-bold text-slate-400 uppercase tracking-wider mb-2">Practicals (SOP)</div>
