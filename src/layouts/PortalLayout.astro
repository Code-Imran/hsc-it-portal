---
// src/layouts/PortalLayout.astro
import '../styles/global.css';
import PortalNavigation from '../components/PortalNavigation.astro';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  schemaData?: Record<string, any>;
}

const {
  title = "HSC Information Technology Portal",
  description = "Maharashtra State Board Class 12 Information Technology (IT) study materials, question banks, and online mock exam simulator.",
  keywords = "HSC IT, Class 12 IT Maharashtra Board, Information Technology Code 97, Information Technology Code 99, HSC IT online exam, Balbharati IT solutions",
  schemaData
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site || "https://yourdomain.in").href;

// Shared topic list for chapter links in the site footer.
const mcqTopics = [
  { slug: "web-designing", name: "Advanced Web Designing", code: "Ch 1" },
  { slug: "digital-marketing-seo", name: "Digital Marketing & SEO", code: "Ch 2" },
  { slug: "advanced-javascript", name: "Advanced JavaScript", code: "Ch 3" },
  { slug: "emerging-technologies", name: "Emerging Technologies", code: "Ch 4" },
  { slug: "server-side-scripting-php", name: "Server-Side Scripting (PHP)", code: "Ch 5" },
  { slug: "ecommerce-egovernance", name: "E-Commerce & E-Governance", code: "Ch 6" },
];


---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <!-- Primary Page Metadata -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content="HSC IT Portal" />
    <meta name="robots" content="index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="HSC IT Portal" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <!-- Rich Snippets Schema -->
    {schemaData && (
      <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
    )}
  </head>
  <body class="bg-slate-50 dark:bg-slate-950 text-slate-800 dark:text-slate-100 min-h-screen flex flex-col transition-colors selection:bg-emerald-500 selection:text-white">
    
    <PortalNavigation />

    <main class="flex-grow">
      <slot />
    </main>

    <!-- Edge-Docked Vertical "Choose Your Stream" Widget -->
    <aside 
      aria-label="Stream Selection Tab"
      class="fixed left-0 top-1/2 -translate-y-1/2 z-50 hidden items-center lg:flex"
    >
      <!-- Vertical Tab Trigger Button -->
      <button 
        id="vertical-stream-trigger"
        type="button"
        class="bg-emerald-600 hover:bg-emerald-500 text-white font-mono text-[11px] font-bold tracking-wider uppercase px-2 py-4 rounded-r-xl shadow-2xl transition-all duration-200 border-y border-r border-emerald-400/40 flex flex-col items-center gap-2 group"
        title="Click to Choose Stream"
      >
        <span class="h-2 w-2 rounded-full bg-white group-hover:scale-125 transition-transform"></span>
        <span style="writing-mode: vertical-rl; transform: rotate(180deg);" class="whitespace-nowrap select-none">
          Choose your stream
        </span>
      </button>

      <!-- Expandable Flyout Card -->
      <div 
        id="stream-flyout-drawer"
        class="hidden ml-2 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white/95 dark:bg-slate-900/95 p-4 shadow-2xl backdrop-blur-md w-56 space-y-3"
      >
        <div class="flex items-center justify-between border-b border-slate-100 dark:border-slate-800 pb-2">
          <span class="text-[10px] font-mono font-bold uppercase text-slate-400">Select Stream</span>
          <span id="current-stream-pill" class="text-[10px] font-mono font-bold text-emerald-600 bg-emerald-50 dark:bg-emerald-950 px-2 py-0.5 rounded">
            Sci (97)
          </span>
        </div>

        <div class="space-y-2">
          <button 
            id="stream-opt-science"
            type="button" 
            class="w-full flex items-center justify-between p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:border-emerald-500 transition text-left"
          >
            <div>
              <p class="font-bold">Science Stream</p>
              <p class="text-[10px] text-slate-400 font-mono">Subject Code 97 (PHP)</p>
            </div>
            <span class="opt-check text-emerald-600 font-bold hidden">✓</span>
          </button>

          <button 
            id="stream-opt-commerce"
            type="button" 
            class="w-full flex items-center justify-between p-2.5 rounded-xl border border-slate-200 dark:border-slate-800 text-xs font-semibold text-slate-700 dark:text-slate-200 hover:border-emerald-500 transition text-left"
          >
            <div>
              <p class="font-bold">Commerce Stream</p>
              <p class="text-[10px] text-slate-400 font-mono">Subject Code 99 (RDBMS)</p>
            </div>
            <span class="opt-check text-emerald-600 font-bold hidden">✓</span>
          </button>
        </div>
      </div>
    </aside>

    <!-- Global Footer with /mcqs/ Links -->
    <footer class="border-t border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/50 py-10 px-4 sm:px-6 text-xs text-slate-500 dark:text-slate-400">
      <div class="max-w-7xl mx-auto space-y-6">
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 pb-6 border-b border-slate-100 dark:border-slate-800">
          <div>
            <p class="font-mono font-bold text-slate-900 dark:text-white uppercase mb-2">Chapter MCQs</p>
            <ul class="space-y-1.5">
              {mcqTopics.slice(0, 3).map((t) => (
                <li><a href={`/mcqs/${t.slug}`} class="hover:text-emerald-600 dark:hover:text-emerald-400">{t.name}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <p class="font-mono font-bold text-slate-900 dark:text-white uppercase mb-2">More MCQs</p>
            <ul class="space-y-1.5">
              {mcqTopics.slice(3).map((t) => (
                <li><a href={`/mcqs/${t.slug}`} class="hover:text-emerald-600 dark:hover:text-emerald-400">{t.name}</a></li>
              ))}
            </ul>
          </div>
          <div>
            <p class="font-mono font-bold text-slate-900 dark:text-white uppercase mb-2">Exam Simulator</p>
            <ul class="space-y-1.5">
              <li><a href="/simulator" class="hover:text-emerald-600 dark:hover:text-emerald-400">80-Mark Mock Test</a></li>
              <li><a href="/#pattern" class="hover:text-emerald-600 dark:hover:text-emerald-400">Q1–Q8 Board Pattern</a></li>
            </ul>
          </div>
          <div>
            <p class="font-mono font-bold text-slate-900 dark:text-white uppercase mb-2">Practicals & Slips</p>
            <ul class="space-y-1.5">
              <li><a href="/practicals" class="hover:text-emerald-600 dark:hover:text-emerald-400">Board Practicals Solutions</a></li>
              <li><a href="/q8-vault" class="hover:text-emerald-600 dark:hover:text-emerald-400">Q8 Code Solutions</a></li>
            </ul>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-between gap-4">
          <p>© 2026–2027 HSC IT Portal. Maharashtra State Board (MSBSHSE) Class 12 Preparation.</p>
          <p class="font-mono text-[11px]">Science Code 97 • Commerce Code 99</p>
        </div>
      </div>
    </footer>

    <!-- Layout & Vertical Stream Widget Scripts -->
    <script is:inline>
      function initLayoutNav() {
        // Vertical Trigger & Flyout Drawer Logic
        const trigger = document.getElementById('vertical-stream-trigger');
        const drawer = document.getElementById('stream-flyout-drawer');
        const sciBtn = document.getElementById('stream-opt-science');
        const commBtn = document.getElementById('stream-opt-commerce');
        const pill = document.getElementById('current-stream-pill');
        const mobileStream = document.getElementById('mobile-stream-select');
        const activeStream = localStorage.getItem('selected_stream') || 'science';

        if (mobileStream) {
          mobileStream.value = activeStream;
          mobileStream.onchange = () => {
            const stream = mobileStream.value;
            if (stream !== 'science' && stream !== 'commerce') return;
            localStorage.setItem('selected_stream', stream);
            window.dispatchEvent(new CustomEvent('streamChange', { detail: { stream } }));
          };
        }

        if (!trigger || !drawer || !sciBtn || !commBtn) return;

        // Toggle Drawer on vertical button click
        trigger.onclick = (e) => {
          e.stopPropagation();
          drawer.classList.toggle('hidden');
        };

        // Close drawer if clicking outside
        document.addEventListener('click', (e) => {
          if (!drawer.contains(e.target) && !trigger.contains(e.target)) {
            drawer.classList.add('hidden');
          }
        });

        function updateUI(stream) {
          const sciCheck = sciBtn.querySelector('.opt-check');
          const commCheck = commBtn.querySelector('.opt-check');
          if (mobileStream) mobileStream.value = stream;

          if (stream === 'commerce') {
            if (pill) pill.textContent = 'Comm (99)';
            commBtn.classList.add('border-emerald-500', 'bg-emerald-50', 'dark:bg-emerald-950/40');
            commBtn.classList.remove('border-slate-200', 'dark:border-slate-800');
            commCheck?.classList.remove('hidden');

            sciBtn.classList.remove('border-emerald-500', 'bg-emerald-50', 'dark:bg-emerald-950/40');
            sciBtn.classList.add('border-slate-200', 'dark:border-slate-800');
            sciCheck?.classList.add('hidden');
          } else {
            if (pill) pill.textContent = 'Sci (97)';
            sciBtn.classList.add('border-emerald-500', 'bg-emerald-50', 'dark:bg-emerald-950/40');
            sciBtn.classList.remove('border-slate-200', 'dark:border-slate-800');
            sciCheck?.classList.remove('hidden');

            commBtn.classList.remove('border-emerald-500', 'bg-emerald-50', 'dark:bg-emerald-950/40');
            commBtn.classList.add('border-slate-200', 'dark:border-slate-800');
            commCheck?.classList.add('hidden');
          }
        }

        updateUI(activeStream);

        sciBtn.onclick = () => {
          localStorage.setItem('selected_stream', 'science');
          updateUI('science');
          window.dispatchEvent(new CustomEvent('streamChange', { detail: { stream: 'science' } }));
          drawer.classList.add('hidden');
        };

        commBtn.onclick = () => {
          localStorage.setItem('selected_stream', 'commerce');
          updateUI('commerce');
          window.dispatchEvent(new CustomEvent('streamChange', { detail: { stream: 'commerce' } }));
          drawer.classList.add('hidden');
        };
      }

      initLayoutNav();
      document.addEventListener('astro:after-swap', initLayoutNav);
    </script>
  
</body>
</html>