                <a href="/downloads/papers" class="block px-3 py-2 rounded-lg hover:bg-slate-50 dark:hover:bg-slate-800 text-slate-800 dark:text-slate-200 text-xs font-medium">Past Board Papers</a>
              </div>
            </div>

            <a href="/q8-vault" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition text-emerald-700 dark:text-emerald-400 font-bold">Q8 (20Marks)</a>
            <a href="/#pattern" class="hover:text-emerald-600 dark:hover:text-emerald-400 transition">Paper Pattern</a>
