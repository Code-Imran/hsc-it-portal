---
// src/components/QuizRunner.astro
interface Question {
  id?: string | number;
  type?: "mcq-single" | "mcq-multi" | "true-false" | "fill-blank";
  question: string;
  options?: string[];
  answer: string | string[];
  explanation?: string;
}

interface Props {
  questions: Question[];
  storageKey: string;
  title?: string;
  listHref?: string;
}

const { questions, storageKey, title = "Chapter Assessment", listHref = "/mcqs" } = Astro.props;

// Normalize question types and answers
const items = questions.map((q) => {
  const ansArray = Array.isArray(q.answer) ? q.answer : [q.answer];
  const detectedType = q.type || (ansArray.length > 1 ? "mcq-multi" : "mcq-single");
  return {
    ...q,
    type: detectedType,
    answers: ansArray,
    options: q.options || (detectedType === "true-false" ? ["True", "False"] : []),
  };
});

const btnAction = "h-11 px-4 sm:px-5 rounded-xl text-xs sm:text-sm font-bold transition flex items-center justify-center gap-1.5 active:scale-95 disabled:opacity-40 disabled:pointer-events-none";
---

<div id="quiz" data-key={storageKey} class="w-full max-w-3xl mx-auto pb-28 sm:pb-10 font-sans">
  
  <!-- 1. Sticky Meta Bar (Question Index & Score) -->
  <div class="sticky top-0 z-20 bg-white/90 dark:bg-slate-950/90 backdrop-blur-md py-3 px-2 sm:px-0 border-b border-slate-200 dark:border-slate-800 flex items-center justify-between mb-5">
    <div class="flex items-center gap-2.5">
      <span class="text-xs font-mono font-bold text-slate-500 dark:text-slate-400" id="q-tracker">
        Q 1 of {items.length}
      </span>
      <span class="h-3 w-px bg-slate-300 dark:bg-slate-700"></span>
      <button 
        id="toggle-pal-btn" 
        type="button" 
        class="text-xs font-semibold text-emerald-600 dark:text-emerald-400 hover:text-emerald-500 flex items-center gap-1 p-1 rounded transition"
      >
        <span>Grid View</span>
        <svg id="pal-chevron" class="w-3.5 h-3.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
      </button>
    </div>
    
    <div class="flex items-center gap-2">
      <span id="q-score" class="text-xs font-mono font-bold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 dark:bg-emerald-950/50 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800/40">
        Score: 0
      </span>
    </div>
  </div>

  <!-- 2. Question Palette Drawer (Collapsible on Mobile, openable anywhere) -->
  <div id="palette-drawer" class="hidden sm:block mb-6 p-4 rounded-2xl bg-slate-50 dark:bg-slate-900 border border-slate-200 dark:border-slate-800 shadow-sm transition-all">
    <div class="flex items-center justify-between mb-2">
      <p class="text-[11px] font-mono text-slate-400 uppercase tracking-wider font-bold">Palette Navigator</p>
      <span class="text-[11px] font-mono text-slate-400">Total: {items.length} Questions</span>
    </div>
    <div id="palette" class="flex flex-wrap gap-1.5 max-h-48 overflow-y-auto pr-1">
      {items.map((_, i) => (
        <button
          type="button"
          data-goto={i}
          class="pal h-9 w-9 rounded-lg border text-xs font-mono font-bold border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 text-slate-600 dark:text-slate-300 transition hover:border-emerald-400 flex items-center justify-center shrink-0"
        >
          {i + 1}
        </button>
      ))}
    </div>
  </div>

  <!-- 3. Question Card Viewport -->
  <div id="quiz-body" class="space-y-4">
    {items.map((item, i) => (
      <section
        class="qcard hidden p-5 sm:p-7 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm transition-all"
        data-type={item.type}
        data-answers={JSON.stringify(item.answers)}
      >
        <div class="flex items-center justify-between gap-2 mb-4">
          <span class="font-mono text-xs font-bold px-2.5 py-1 rounded-md bg-slate-100 dark:bg-slate-800 text-slate-700 dark:text-slate-300">
            Question {i + 1}
          </span>
          <span class="text-[11px] font-mono font-medium text-emerald-700 dark:text-emerald-400 bg-emerald-50 dark:bg-emerald-950/40 px-2.5 py-1 rounded border border-emerald-200 dark:border-emerald-800/40">
            {item.type === "mcq-multi"
              ? `Select ${item.answers.length} Options`
              : item.type === "fill-blank"
              ? "Fill in the blank"
              : item.type === "true-false"
              ? "True or False"
              : "Select 1 Option"}
          </span>
        </div>

        <p class="text-base sm:text-lg font-bold text-slate-900 dark:text-white leading-relaxed mb-6">
          {item.question}
        </p>

        <!-- Options Container -->
        {item.type !== "fill-blank" ? (
          <div class="space-y-2.5">
            {item.options.map((opt) => (
              <button
                type="button"
                data-value={opt}
                class="opt w-full text-left p-3.5 sm:p-4 rounded-xl border border-slate-200 dark:border-slate-800 text-sm font-medium text-slate-800 dark:text-slate-200 transition flex items-center justify-between gap-3 active:bg-slate-100 dark:active:bg-slate-800"
              >
                <span class="leading-snug">{opt}</span>
                <span class="mark hidden text-xs font-mono font-bold shrink-0"></span>
              </button>
            ))}
          </div>
        ) : (
          <div class="space-y-3">
            <input
              type="text"
              class="blank-input w-full p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50 dark:bg-slate-950 text-sm font-semibold focus:border-emerald-500 focus:bg-white dark:focus:bg-slate-900 focus:outline-none transition"
              placeholder="Type your answer here..."
              autocomplete="off"
            />
          </div>
        )}

        <!-- Feedback Box -->
        <div class="fb hidden mt-5 p-4 rounded-xl border text-xs sm:text-sm leading-relaxed transition-all">
          <p class="fb-title font-bold text-sm mb-1"></p>
          <p class="font-medium text-slate-700 dark:text-slate-200">
            <span class="font-bold">Correct Answer:</span> <span class="fb-ans font-mono"></span>
          </p>
          {item.explanation && (
            <p class="text-slate-600 dark:text-slate-300 mt-2 pt-2 border-t border-slate-200 dark:border-slate-800">{item.explanation}</p>
          )}
        </div>
      </section>
    ))}
  </div>

  <!-- 4. Fixed Thumb-Reachable Action Dock -->
  <div class="fixed sm:static bottom-0 left-0 right-0 z-30 p-3 sm:p-0 bg-white/95 sm:bg-transparent dark:bg-slate-950/95 sm:dark:bg-transparent backdrop-blur-md sm:backdrop-blur-none border-t sm:border-t-0 border-slate-200 dark:border-slate-800 mt-6">
    <div class="max-w-3xl mx-auto flex items-center justify-between gap-2">
      <button 
        id="btn-prev" 
        type="button" 
        class={`${btnAction} border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-200 hover:bg-slate-100 dark:hover:bg-slate-800`}
      >
        ← Prev
      </button>

      <div class="flex items-center gap-2">
        <button 
          id="btn-mark" 
          type="button" 
          class={`${btnAction} border border-amber-300 dark:border-amber-700 text-amber-700 dark:text-amber-400 bg-amber-50/60 dark:bg-amber-950/20`}
        >
          ☆ Flag
        </button>
        <button 
          id="btn-check" 
          type="button" 
          class={`${btnAction} hidden bg-slate-900 dark:bg-white text-white dark:text-slate-900 shadow-sm`}
        >
          Check
        </button>
        <button 
          id="btn-next" 
          type="button" 
          class={`${btnAction} bg-emerald-600 hover:bg-emerald-500 text-white shadow-md shadow-emerald-600/20`}
        >
          <span>Next</span> →
        </button>
      </div>
    </div>
  </div>

  <!-- 5. Summary / Score Card -->
  <div id="quiz-summary" class="hidden p-6 sm:p-8 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 text-center space-y-6">
    <div>
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Assessment Complete</span>
      <p id="sum-score" class="text-4xl sm:text-5xl font-black text-slate-900 dark:text-white mt-2"></p>
      <p id="sum-msg" class="text-sm text-slate-600 dark:text-slate-300 mt-2 max-w-md mx-auto"></p>
      <p id="sum-best" class="text-xs font-mono text-slate-400 mt-1"></p>
    </div>

    <div id="sum-wrong-box" class="hidden text-left p-4 rounded-xl bg-slate-50 dark:bg-slate-950 border border-slate-200 dark:border-slate-800">
      <p class="text-xs font-mono font-bold uppercase text-rose-600 dark:text-rose-400 mb-2">Review Incorrect Answers</p>
      <div id="sum-wrong" class="flex flex-wrap gap-2"></div>
    </div>

    <div class="flex flex-col sm:flex-row gap-3 justify-center pt-2">
      <button id="btn-retry" type="button" class={`${btnAction} border border-slate-300 dark:border-slate-700 text-slate-700 dark:text-slate-300`}>
        ↻ Retake Chapter
      </button>
      <a href={listHref} class={`${btnAction} bg-emerald-600 text-white`}>
        All Chapter MCQs →
      </a>
    </div>
  </div>
</div>

<script>
  function initQuizEngine() {
    const root = document.getElementById("quiz");
    if (!root || root.dataset.ready) return;
    root.dataset.ready = "1";

    const cards = Array.from(root.querySelectorAll(".qcard"));
    const pals = Array.from(root.querySelectorAll(".pal"));
    const body = document.getElementById("quiz-body");
    const summary = document.getElementById("quiz-summary");
    const palDrawer = document.getElementById("palette-drawer");
    const chevron = document.getElementById("pal-chevron");
    const bestKey = "quiz-best:" + root.dataset.key;

    let cur = 0;
    let st = cards.map(() => ({ sel: [], val: "", checked: false, ok: false, mark: false }));

    // Toggle Palette Drawer on Mobile
    document.getElementById("toggle-pal-btn")?.addEventListener("click", () => {
      const isClosed = palDrawer.classList.contains("hidden");
      palDrawer.classList.toggle("hidden");
      if (chevron) chevron.style.transform = isClosed ? "rotate(180deg)" : "rotate(0deg)";
    });

    const answersOf = (i) => JSON.parse(cards[i].dataset.answers);

    function paintUI() {
      cards.forEach((c, idx) => c.classList.toggle("hidden", idx !== cur));
      document.getElementById("q-tracker").textContent = `Q ${cur + 1} of ${cards.length}`;
      document.getElementById("q-score").textContent = `Score: ${st.filter((x) => x.ok).length}`;
      
      const prevBtn = document.getElementById("btn-prev");
      if (prevBtn) prevBtn.disabled = cur === 0;

      const nextSpan = document.getElementById("btn-next")?.querySelector("span");
      if (nextSpan) nextSpan.textContent = cur === cards.length - 1 ? "Finish" : "Next";

      const markBtn = document.getElementById("btn-mark");
      if (markBtn) markBtn.textContent = st[cur].mark ? "★ Flagged" : "☆ Flag";

      // Palette Indicator Updates
      pals.forEach((p, idx) => {
        const item = st[idx];
        p.className = "pal h-9 w-9 rounded-lg border text-xs font-mono font-bold transition flex items-center justify-center shrink-0 ";
        
        if (item.checked) {
          p.className += item.ok 
            ? "border-emerald-600 bg-emerald-600 text-white" 
            : "border-rose-500 bg-rose-500 text-white";
        } else if (item.sel.length > 0 || (item.val && item.val.trim().length > 0)) {
          p.className += "border-slate-400 bg-slate-200 dark:bg-slate-700 text-slate-900 dark:text-white";
        } else {
          p.className += "border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-950 text-slate-500";
        }

        if (item.mark) p.classList.add("ring-2", "ring-amber-400");
        if (idx === cur) p.classList.add("ring-2", "ring-emerald-500");
      });

      // Check Button Visibility
      const isMulti = cards[cur].dataset.type === "mcq-multi";
      const isBlank = cards[cur].dataset.type === "fill-blank";
      const hasAnswer = isBlank ? st[cur].val.trim().length > 0 : st[cur].sel.length > 0;
      
      const checkBtn = document.getElementById("btn-check");
      if (checkBtn) {
        checkBtn.classList.toggle("hidden", st[cur].checked || !hasAnswer);
      }
    }

    function checkAnswer(idx) {
      const s = st[idx];
      const card = cards[idx];
      const type = card.dataset.type;
      const ans = answersOf(idx);

      if (s.checked) return;

      if (type === "fill-blank") {
        s.ok = ans.some((a) => a.trim().toLowerCase() === s.val.trim().toLowerCase());
      } else {
        s.ok = s.sel.length === ans.length && ans.every((a) => s.sel.includes(a));
      }
      s.checked = true;

      // Render Feedback
      const fb = card.querySelector(".fb");
      fb.classList.remove("hidden");
      fb.className = `fb mt-5 p-4 rounded-xl border text-xs sm:text-sm leading-relaxed ${
        s.ok 
          ? "border-emerald-200 bg-emerald-50 text-emerald-900 dark:border-emerald-900 dark:bg-emerald-950/40 dark:text-emerald-200" 
          : "border-rose-200 bg-rose-50 text-rose-900 dark:border-rose-900 dark:bg-rose-950/40 dark:text-rose-200"
      }`;
      fb.querySelector(".fb-title").textContent = s.ok ? "✓ Correct!" : "✗ Incorrect";
      fb.querySelector(".fb-ans").textContent = ans.join(" OR ");

      // Lock Options Visuals
      card.querySelectorAll(".opt").forEach((btn) => {
        const v = btn.dataset.value;
        const mark = btn.querySelector(".mark");
        mark.classList.remove("hidden");

        if (ans.includes(v)) {
          btn.className = "opt w-full text-left p-3.5 sm:p-4 rounded-xl border border-emerald-500 bg-emerald-100/50 dark:bg-emerald-950/40 text-sm font-medium text-slate-800 dark:text-slate-200 flex items-center justify-between";
          mark.textContent = "✓ Correct";
          mark.className = "mark text-xs font-mono font-bold text-emerald-600";
        } else if (s.sel.includes(v)) {
          btn.className = "opt w-full text-left p-3.5 sm:p-4 rounded-xl border border-rose-500 bg-rose-100/40 dark:bg-rose-950/30 text-sm font-medium text-slate-800 dark:text-slate-200 flex items-center justify-between";
          mark.textContent = "✗ Your Pick";
          mark.className = "mark text-xs font-mono font-bold text-rose-600";
        }
      });

      paintUI();
    }

    // Bind Option Event Handlers
    cards.forEach((card, idx) => {
      const type = card.dataset.type;
      const ans = answersOf(idx);

      if (type === "fill-blank") {
        const inp = card.querySelector(".blank-input");
        inp.addEventListener("input", (e) => {
          st[idx].val = e.target.value;
          paintUI();
        });
      } else {
        card.querySelectorAll(".opt").forEach((btn) => {
          btn.addEventListener("click", () => {
            if (st[idx].checked) return;
            const v = btn.dataset.value;

            if (type === "mcq-single" || type === "true-false") {
              st[idx].sel = [v];
              checkAnswer(idx);
            } else {
              const pos = st[idx].sel.indexOf(v);
              if (pos > -1) {
                st[idx].sel.splice(pos, 1);
              } else if (st[idx].sel.length < ans.length) {
                st[idx].sel.push(v);
              }

              // Update selection styling before "Check" is pressed
              card.querySelectorAll(".opt").forEach((b) => {
                const isSelected = st[idx].sel.includes(b.dataset.value);
                b.classList.toggle("border-emerald-500", isSelected);
                b.classList.toggle("bg-emerald-50/50", isSelected);
                b.classList.toggle("dark:bg-emerald-950/30", isSelected);
              });
            }
            paintUI();
          });
        });
      }
    });

    // Palette direct question navigation
    pals.forEach((p, idx) => {
      p.addEventListener("click", () => {
        cur = idx;
        paintUI();
        // Close mobile drawer on item tap
        if (window.innerWidth < 640) {
          palDrawer.classList.add("hidden");
          if (chevron) chevron.style.transform = "rotate(0deg)";
        }
      });
    });

    // Navigation Controls
    document.getElementById("btn-prev")?.addEventListener("click", () => {
      if (cur > 0) {
        cur--;
        paintUI();
      }
    });

    document.getElementById("btn-next")?.addEventListener("click", () => {
      if (cur < cards.length - 1) {
        cur++;
        paintUI();
      } else {
        finish();
      }
    });

    document.getElementById("btn-check")?.addEventListener("click", () => checkAnswer(cur));
    document.getElementById("btn-mark")?.addEventListener("click", () => {
      st[cur].mark = !st[cur].mark;
      paintUI();
    });

    function finish() {
      const score = st.filter((x) => x.ok).length;
      const pct = Math.round((score / cards.length) * 100);

      try {
        const prevBest = Number(localStorage.getItem(bestKey) || 0);
        if (pct > prevBest) localStorage.setItem(bestKey, String(pct));
        document.getElementById("sum-best").textContent = `Best score on this device: ${Math.max(pct, prevBest)}%`;
      } catch (e) {}

      document.getElementById("sum-score").textContent = `${score} / ${cards.length} (${pct}%)`;
      document.getElementById("sum-msg").textContent =
        pct >= 80 ? "Superb! You are fully board exam ready for this unit." : "Solid practice run. Review your missed items below.";

      const wrongBox = document.getElementById("sum-wrong");
      wrongBox.innerHTML = "";
      st.forEach((s, idx) => {
        if (!s.ok) {
          const b = document.createElement("button");
          b.type = "button";
          b.textContent = `Q${idx + 1}${s.checked ? "" : " (skipped)"}`;
          b.className = "px-2.5 py-1.5 rounded-lg border border-rose-300 dark:border-rose-800 text-xs font-mono font-bold text-rose-600 dark:text-rose-400 hover:bg-rose-50 dark:hover:bg-rose-950/30";
          b.onclick = () => {
            summary.classList.add("hidden");
            body.classList.remove("hidden");
            cur = idx;
            paintUI();
          };
          wrongBox.appendChild(b);
        }
      });

      document.getElementById("sum-wrong-box").classList.toggle("hidden", wrongBox.children.length === 0);
      body.classList.add("hidden");
      summary.classList.remove("hidden");
      window.scrollTo({ top: 0, behavior: "smooth" });
    }

    document.getElementById("btn-retry")?.addEventListener("click", () => {
      st = cards.map(() => ({ sel: [], val: "", checked: false, ok: false, mark: false }));
      cards.forEach((c) => {
        c.querySelector(".fb")?.classList.add("hidden");
        const inp = c.querySelector(".blank-input");
        if (inp) inp.value = "";
        c.querySelectorAll(".opt").forEach((b) => {
          b.className = "opt w-full text-left p-3.5 sm:p-4 rounded-xl border border-slate-200 dark:border-slate-800 text-sm font-medium text-slate-800 dark:text-slate-200 flex items-center justify-between gap-3";
          b.querySelector(".mark")?.classList.add("hidden");
        });
      });
      cur = 0;
      summary.classList.add("hidden");
      body.classList.remove("hidden");
      paintUI();
    });

    paintUI();
  }

  // Support direct Astro page transitions
  initQuizEngine();
  document.addEventListener("astro:after-swap", initQuizEngine);
</script>