---
import PortalLayout from "../layouts/PortalLayout.astro";

// --- SEO CONFIGURATION ---
const pageTitle = "Information Technology (IT) Notes for Std. 12th HSC Board Exam";
const pageDescription = "★★★★★ 5-Star Rated HSC IT Preparation Resource — Prepare for the Maharashtra State Board Class 12 Information Technology exam with important notes, previous year questions with solutions, chapter-wise question banks, practical SOP codes, viva questions, and an online 80-mark mock exam.";
const pageKeywords = "HSC IT notes, Class 12 Information Technology Maharashtra Board, HSC IT question bank, HSC IT Science Code 97, HSC IT Commerce Code 99, Std 12 IT practical SOP codes, Balbharati IT solutions Class 12, HSC IT online exam simulator, IT 80 marks paper pattern, Advanced Web Designing class 12, Advanced JavaScript notes HSC";

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "Maharashtra HSC Std. 12th Information Technology (IT) Complete Preparation",
  "description": pageDescription,
  "educationalLevel": "Higher Secondary Certificate (Class 12 - MSBSHSE)",
  "provider": { "@type": "Organization", "name": "HSC IT Portal" },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "128",
    "bestRating": "5",
    "worstRating": "1"
  }
};

// --- SCIENCE SYLLABUS (CODE 97) ---
const scienceChapters = [
  { no: "Chapter 1", slug: "web-designing", title: "Advanced Web Designing", marks: "20 - 25 Marks", topics: "HTML5 Form controls, CSS3 styling, Flexbox layout, Audio/Video tags, Client-side Image maps (map and area tags).", tag: "Theory + SOP" },
  { no: "Chapter 2", slug: "digital-marketing-seo", title: "Digital Marketing & SEO", marks: "10 - 12 Marks", topics: "On-Page SEO, Off-Page SEO, Page Rank, Audit Tools, Meta tags, White Hat vs Black Hat strategies.", tag: "Theory Only" },
  { no: "Chapter 3", slug: "advanced-javascript", title: "Advanced JavaScript", marks: "15 - 20 Marks", topics: "Event handling (onsubmit, onchange), DOM manipulation, Form validation, Built-in String/Math/Date objects.", tag: "Theory + SOP" },
  { no: "Chapter 4", slug: "emerging-technologies", title: "Emerging Technologies", marks: "8 - 10 Marks", topics: "IoT architecture, Cloud Computing models (IaaS, PaaS, SaaS), Artificial Intelligence, 5G wireless networks.", tag: "Theory Only" },
  { no: "Chapter 5", slug: "server-side-scripting-php", title: "Server-Side Scripting (PHP)", marks: "12 - 15 Marks", topics: "PHP syntax, form processing via POST/GET, Associative arrays, User-defined functions, Form security.", tag: "Theory + SOP" },
  { no: "Chapter 6", slug: "ecommerce-egovernance", title: "E-Commerce & E-Governance", marks: "8 - 10 Marks", topics: "E-Commerce models (B2B, B2C, C2C), Payment gateways, Security, EDI, E-Governance models (G2C, G2B, G2G).", tag: "Theory Only" },
];

// --- COMMERCE SYLLABUS (CODE 99) ---
const commerceChapters = [
  { no: "Chapter 1", slug: "web-designing", title: "Advanced Web Designing", marks: "20 - 25 Marks", topics: "HTML5 Form controls, CSS3 page layout, Responsive styling, Audio/Video embeds, Client-side forms.", tag: "Theory + SOP" },
  { no: "Chapter 2", slug: "digital-marketing-seo", title: "Digital Marketing & SEO", marks: "10 - 12 Marks", topics: "Search Engine Optimization, Keywords, Page rank metrics, Website audit tools, Business meta tags.", tag: "Theory Only" },
  { no: "Chapter 3", slug: "advanced-javascript", title: "Advanced JavaScript", marks: "15 - 20 Marks", topics: "Event handling (onsubmit, onclick), Form calculation & validation, String & Math methods.", tag: "Theory + SOP" },
  { no: "Chapter 4", slug: "emerging-technologies", title: "Emerging Technologies", marks: "8 - 10 Marks", topics: "Cloud services for commerce, IoT ecosystem, AI applications in enterprise, High-speed networks.", tag: "Theory Only" },
  { no: "Chapter 5", slug: "database-concepts-rdbms", title: "Database Concepts (RDBMS)", marks: "15 - 18 Marks", topics: "Database design, Tables, Primary keys, Foreign keys, SQL queries (CREATE, INSERT, SELECT), Normalization.", tag: "Theory + SOP" },
  { no: "Chapter 6", slug: "ecommerce-egovernance", title: "E-Commerce & E-Governance", marks: "10 - 12 Marks", topics: "B2B/B2C/C2C architectures, Electronic Data Interchange (EDI), Cyber laws, Digital signatures, Payment gateways.", tag: "Theory Only" },
];

const boardPattern = [
  { q: "Q1", format: "Fill in the Blanks", questions: "10 Questions", marksEach: "1 Mark", total: "10 Marks" },
  { q: "Q2", format: "State True or False", questions: "10 Questions", marksEach: "1 Mark", total: "10 Marks" },
  { q: "Q3", format: "Multiple Choice (1 Correct Answer)", questions: "10 Questions", marksEach: "1 Mark", total: "10 Marks" },
  { q: "Q4", format: "Multiple Choice (2 Correct Answers)", questions: "5 Questions", marksEach: "2 Marks", total: "10 Marks" },
  { q: "Q5", format: "Multiple Choice (3 Correct Answers)", questions: "2 Questions", marksEach: "3 Marks", total: "6 Marks" },
  { q: "Q6", format: "Match the Following Pairs", questions: "4 Questions", marksEach: "1 Mark", total: "4 Marks" },
  { q: "Q7", format: "Answer in Brief (Any 5 out of 8)", questions: "5 of 8 Questions", marksEach: "2 Marks", total: "10 Marks" },
  { q: "Q8", format: "Write Programs / SOP Tasks (Any 2 of 4)", questions: "2 of 4 Tasks", marksEach: "10 Marks", total: "20 Marks" },
];
---

<PortalLayout 
  title={pageTitle}
  description={pageDescription}
  keywords={pageKeywords}
  schemaData={pageSchema}
>
  <!-- Load pdfmake and vfs_fonts via CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js" is:inline></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js" is:inline></script>

  <!-- Hero Section -->
  <section class="border-b border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900/60 py-12 sm:py-16 md:py-20 px-4 sm:px-6 transition-colors">
    <div class="max-w-4xl mx-auto text-center space-y-5 sm:space-y-6">
      
      <!-- Dynamic Stream Badge -->
      <div class="inline-flex items-center gap-2 px-3 py-1 sm:px-3.5 sm:py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-800 dark:text-emerald-300 text-[11px] sm:text-xs font-mono font-bold tracking-tight shadow-sm">
        <span class="h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
        <span id="hero-stream-label">MAHARASHTRA STATE BOARD • SCIENCE (CODE 97)</span>
      </div>
      
      <h1 class="text-3xl sm:text-5xl lg:text-6xl font-black text-slate-900 dark:text-white tracking-tight leading-tight mb-4">INFORMATION TECHNOLOGY PORTAL BY SUBJECT EXPERTS</h1>

      <p class="text-sm sm:text-base md:text-lg text-slate-600 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed">
        <strong>Your complete toolkit for Maharashtra Board Class 12:  From chapter wise MCQs to Most Likely Questions, 80 Marks Question Generator with Answer Keys, SOP Codes for Final Board Practicals.</strong>.
      </p>

      <!-- Hero CTA  -->	
	  <p class="text-sm sm:text-base md:text-lg text-slate-900 dark:text-slate-300 max-w-3xl mx-auto leading-relaxed"><strong>Overcome online Exam fear with our exam software! Try our live 80-mark Computerized Online Mock Exam </strong></p>
      <div class="flex items-center justify-center pt-2">
        <a href="/simulator" class="w-full sm:w-auto px-7 py-3.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white font-bold text-sm transition shadow-lg shadow-emerald-600/30 flex items-center justify-center gap-2 cursor-pointer">
          Start Online Mock Exam (80 Marks)
          <span>→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Metric Badges -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 -mt-6 sm:-mt-8">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
      <div class="p-4 sm:p-5 rounded-xl sm:rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-md">
        <p class="text-[11px] sm:text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Total Weightage</p>
        <p class="text-xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">100 Marks</p>
        <span class="text-[11px] sm:text-xs text-emerald-600 dark:text-emerald-400 font-bold mt-1 inline-block">80 Theory + 20 Practical</span>
      </div>
      <div class="p-4 sm:p-5 rounded-xl sm:rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-md">
        <p class="text-[11px] sm:text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Online Duration</p>
        <p class="text-xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">2.5 Hours</p>
        <span class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 font-medium mt-1 inline-block">Computerized Online Exam</span>
      </div>
      <div class="p-4 sm:p-5 rounded-xl sm:rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-md">
        <p class="text-[11px] sm:text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Balbharati Keys</p>
        <p class="text-xl sm:text-3xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-1">100%</p>
        <span class="text-[11px] sm:text-xs text-slate-500 dark:text-slate-400 font-medium mt-1 inline-block">Chapters 1 to 6 Solved</span>
      </div>
      <div class="p-4 sm:p-5 rounded-xl sm:rounded-2xl border border-slate-200/90 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-md">
        <p class="text-[11px] sm:text-xs font-semibold text-slate-500 dark:text-slate-400 uppercase tracking-wider">Board Practicals</p>
        <p class="text-xl sm:text-3xl font-extrabold text-slate-900 dark:text-white mt-1">12 Labs</p>
        <span id="metric-sop-tag" class="text-[11px] sm:text-xs text-emerald-600 dark:text-emerald-400 font-bold mt-1 inline-block">HTML5, JS & PHP</span>
      </div>
    </div>
  </section>

  <!-- QUESTION BANK BANNER -->
  <section class="w-full border-y-2 border-emerald-500/50 dark:border-emerald-500/40 bg-white dark:bg-slate-900/90 py-10 sm:py-14 mt-12 sm:mt-16 transition-colors shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="flex flex-col items-center text-center gap-6 max-w-4xl mx-auto">
        <div class="space-y-3 max-w-3xl">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-800 dark:text-emerald-300 text-xs font-mono font-bold tracking-tight">
            <span> Unlimited Question Paper Bank at your finger tip</span>
          </div>

          <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-slate-900 dark:text-white leading-tight">
             ⚡Generate Mock Question Paper Set with answer keys in seconds!!
          </h2>

          <div class="text-xs sm:text-sm text-slate-600 dark:text-slate-300 leading-relaxed space-y-1">
            <p> Prepare smarter for the Maharashtra HSC Class 12 IT computerized online board exam.</p>
            <p> Instantly generate randomized, full-length 80-mark practice papers across all 8 standard sections.</p>
            <p> Validate your answers against step-by-step model keys and Balbharati marking criteria.</p>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 w-full sm:w-auto pt-2 mx-auto">
          <button 
            id="generate-board-pdf-btn"
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white font-bold text-sm transition shadow-lg shadow-cyan-600/20 flex items-center justify-center gap-2 cursor-pointer active:scale-95"
          >
            <span>Download Board Paperset (PDF)</span>
            <span>📄</span>
          </button>
          <button 
            id="generate-answer-key-btn"
            disabled
            class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-slate-700 text-white font-bold text-sm transition shadow-lg shadow-slate-700/20 flex items-center justify-center gap-2 opacity-40 cursor-not-allowed active:scale-95"
          >
            <span>Download Answer Keys (PDF)</span>
            <span>🔑</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- COLORFUL LAUNCHPAD CARD: MCQs -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 pt-12 sm:pt-14">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-700 p-6 sm:p-10 text-white shadow-xl">
      <div class="absolute -right-10 -bottom-10 w-64 h-64 bg-white/10 rounded-full blur-2xl pointer-events-none"></div>
      
      <div class="relative z-10 max-w-2xl space-y-3 sm:space-y-4">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/20 backdrop-blur-md text-[11px] font-mono font-bold tracking-wider uppercase">
          <span>⚡ High-Yield Practice</span>
        </div>
        <h2 class="text-2xl sm:text-3xl font-black tracking-tight text-white leading-tight">
          Chapter-Wise MCQs
        </h2>
        <p class="text-xs sm:text-sm text-emerald-50 leading-relaxed">
          Master each chapter individually before taking the full 80-mark mock exam. Test yourself on <strong>Advanced Web Designing, SEO, JavaScript, PHP, and E-Commerce</strong> with instant answers.
        </p>

        <!-- Topic Badges / Instant Jump Buttons to /mcqs/ -->
        <div class="flex flex-wrap gap-2 pt-2">
          {scienceChapters.map((ch) => (
            <a 
              href={`/mcqs/${ch.slug}`}
              class="px-3 py-1.5 rounded-lg bg-white/15 hover:bg-white text-white hover:text-emerald-900 font-medium text-xs transition duration-150 backdrop-blur-sm border border-white/20 flex items-center gap-1"
            >
              <span>{ch.title}</span>
              <span class="text-[10px] opacity-75">→</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Chapters Grid Section -->
  <section id="syllabus" class="max-w-7xl mx-auto px-4 sm:px-6 py-12 sm:py-16">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-8 gap-4">
      <div>
        <div class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400 mb-1">Textbook Syllabus & Notes</div>
        <h2 id="syllabus-heading" class="text-2xl sm:text-3xl font-extrabold text-slate-900 dark:text-white">
          Class 12 IT Units (Science Code 97)
        </h2>
        <p id="syllabus-subheading" class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1">
          Maharashtra State Board chapter-wise distribution for Science stream.
        </p>
      </div>
      <span class="text-xs font-mono font-bold text-emerald-800 dark:text-emerald-300 border border-emerald-300 dark:border-emerald-500/30 bg-emerald-50 dark:bg-emerald-500/10 px-3.5 py-1.5 rounded-lg w-fit">
        Total Theory: 80 Marks
      </span>
    </div>

    <!-- Science Chapter Cards Container -->
    <div id="grid-science" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {scienceChapters.map((ch) => (
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 sm:p-6 flex flex-col justify-between shadow-sm hover:shadow-md hover:border-emerald-500/40 dark:hover:border-slate-700 transition duration-150">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-mono font-bold text-emerald-700 dark:text-emerald-400 tracking-tight bg-emerald-50 dark:bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-200 dark:border-emerald-500/20">
                {ch.no}
              </span>
              <span class="text-xs font-mono font-bold text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-800 px-2.5 py-1 rounded-md border border-slate-200 dark:border-slate-700">
                {ch.marks}
              </span>
            </div>

            <h3 class="font-bold text-slate-900 dark:text-white text-base leading-snug mb-2">
              {ch.title}
            </h3>

            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
              {ch.topics}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs">
            <span class="text-slate-500 dark:text-slate-400 font-medium text-[11px]">{ch.tag}</span>
            <a href={`/mcqs/${ch.slug}`} class="text-emerald-600 dark:text-emerald-400 font-bold hover:text-emerald-700 dark:hover:text-emerald-300 flex items-center gap-1 transition">
              Topic MCQs →
            </a>
          </div>
        </div>
      ))}
    </div>

    <!-- Commerce Chapter Cards Container -->
    <div id="grid-commerce" class="hidden grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5 sm:gap-6">
      {commerceChapters.map((ch) => (
        <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 sm:p-6 flex flex-col justify-between shadow-sm hover:shadow-md hover:border-emerald-500/40 dark:hover:border-slate-700 transition duration-150">
          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-mono font-bold text-emerald-700 dark:text-emerald-400 tracking-tight bg-emerald-50 dark:bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-200 dark:border-emerald-500/20">
                {ch.no}
              </span>
              <span class="text-xs font-mono font-bold text-slate-900 dark:text-white bg-slate-100 dark:bg-slate-800 px-2.5 py-1 rounded-md border border-slate-200 dark:border-slate-700">
                {ch.marks}
              </span>
            </div>

            <h3 class="font-bold text-slate-900 dark:text-white text-base leading-snug mb-2">
              {ch.title}
            </h3>

            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed font-normal">
              {ch.topics}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-slate-100 dark:border-slate-800/80 flex items-center justify-between text-xs">
            <span class="text-slate-500 dark:text-slate-400 font-medium text-[11px]">{ch.tag}</span>
            <a href={`/mcqs/${ch.slug}`} class="text-emerald-600 dark:text-emerald-400 font-bold hover:text-emerald-700 dark:hover:text-emerald-300 flex items-center gap-1 transition">
              Topic MCQs →
            </a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Paper Pattern Section -->
  <section id="pattern" class="max-w-7xl mx-auto px-4 sm:px-6 pb-20">
    <div class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-5 sm:p-8 shadow-sm">
      <div class="mb-6">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Board Evaluation Blueprint</span>
        <h2 id="pattern-title" class="text-xl sm:text-2xl font-extrabold text-slate-900 dark:text-white mt-1">
          HSC IT Exam Paper Pattern for Science (Subject Code 97)
        </h2>
        <p id="pattern-tagline" class="text-xs text-slate-500 dark:text-slate-400 mt-1">
          Official Maharashtra Board Online Exam March 2027 Q1 to Q8 pattern with marks.
        </p>
      </div>

      <!-- Mobile Cards -->
      <div class="block md:hidden space-y-3">
        {boardPattern.map((row) => (
          <div class="p-4 rounded-xl border border-slate-200 dark:border-slate-800 bg-slate-50/60 dark:bg-slate-950/60 flex flex-col justify-between gap-3">
            <div class="flex items-center justify-between">
              <span class="font-mono font-bold text-xs px-2.5 py-0.5 rounded bg-emerald-100 dark:bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-500/20">
                {row.q}
              </span>
              <span class="font-mono font-bold text-sm text-slate-900 dark:text-white">
                {row.total}
              </span>
            </div>

            <div>
              <p class="font-semibold text-slate-900 dark:text-slate-100 text-sm">{row.format}</p>
              <div class="flex items-center gap-3 mt-1.5 text-xs text-slate-500 dark:text-slate-400 font-mono">
                <span>{row.questions}</span>
                <span>•</span>
                <span>{row.marksEach} each</span>
              </div>
            </div>
          </div>
        ))}

        <div class="p-4 rounded-xl border-2 border-emerald-500/40 bg-emerald-50/80 dark:bg-emerald-950/30 flex items-center justify-between font-bold">
          <div>
            <p class="text-xs text-emerald-900 dark:text-emerald-300">Total Online Exam</p>
            <p class="text-[11px] text-emerald-700 dark:text-emerald-400 font-normal">March 2027 Final Evaluation</p>
          </div>
          <span class="font-mono text-emerald-800 dark:text-emerald-300 text-lg">80 Marks</span>
        </div>
      </div>

      <!-- Desktop Table -->
      <div class="hidden md:block overflow-x-auto rounded-xl border border-slate-200 dark:border-slate-800">
        <table class="w-full text-left text-xs">
          <thead class="bg-slate-50 dark:bg-slate-950 text-[11px] uppercase tracking-wider text-slate-700 dark:text-slate-400 border-b border-slate-200 dark:border-slate-800">
            <tr>
              <th class="px-5 py-3.5 font-bold">Section</th>
              <th class="px-5 py-3.5 font-bold">Question Format</th>
              <th class="px-5 py-3.5 font-bold">Total Items</th>
              <th class="px-5 py-3.5 font-bold">Marks / Item</th>
              <th class="px-5 py-3.5 font-bold text-right">Section Weightage</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100 dark:divide-slate-800/80 bg-white dark:bg-slate-900/50">
            {boardPattern.map((row) => (
              <tr class="hover:bg-slate-50/80 dark:hover:bg-slate-800/40 transition">
                <td class="px-5 py-3.5 font-mono font-bold text-emerald-700 dark:text-emerald-400">{row.q}</td>
                <td class="px-5 py-3.5 font-semibold text-slate-900 dark:text-slate-100">{row.format}</td>
                <td class="px-5 py-3.5 text-slate-600 dark:text-slate-300 font-medium">{row.questions}</td>
                <td class="px-5 py-3.5 font-mono text-slate-600 dark:text-slate-400">{row.marksEach}</td>
                <td class="px-5 py-3.5 font-mono font-bold text-right text-slate-900 dark:text-white">{row.total}</td>
              </tr>
            ))}
            <tr class="bg-emerald-50/80 dark:bg-emerald-950/30 border-t-2 border-emerald-500/40 font-bold">
              <td colspan="4" class="px-5 py-4 text-emerald-900 dark:text-emerald-300 text-sm">
                Total Marks for Information Technology Online Exam March 2027
              </td>
              <td class="px-5 py-4 font-mono text-right text-emerald-800 dark:text-emerald-300 text-base">
                80 Marks
              </td>
            </tr>
          </tbody>
        </table>
      </div>

      <!-- Short Notes Callout Banner (Q7 Focus) -->
      <div class="my-8 p-5 rounded-2xl bg-gradient-to-r from-emerald-950 via-slate-900 to-slate-950 text-white flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 border border-emerald-800/50 shadow-md">
        <div class="space-y-1.5">
          <div class="flex items-center gap-2">
            <span class="px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
              NEW: Q7 SECTION (8 MARKS)
            </span>
            <span class="text-xs text-slate-400">• Answer 2 of 4 (4 Marks Each)</span>
          </div>
          <h3 class="text-base sm:text-lg font-bold">HSC IT Model Short Notes</h3>
          <p class="text-xs text-slate-300 max-w-xl">
            Point-by-point scoring answers tailored for board moderators across Web Designing, SEO, PHP, and E-Commerce.
          </p>
        </div>
        <a 
          href="/short-notes" 
          class="shrink-0 px-4 py-2.5 rounded-xl bg-emerald-500 hover:bg-emerald-400 text-slate-950 font-bold text-xs sm:text-sm transition flex items-center gap-1.5 active:scale-95 shadow-lg shadow-emerald-500/20"
        >
          <span>Explore Short Notes</span>
          <span>→</span>
        </a>
      </div>

    </div>
  </section>

  <!-- Client-side Stream Filtering & PDF Generation Script -->
  <script is:inline>
    /* SECTION: STREAM_SWITCHING_LOGIC */
    function updateHomepageStream(stream) {
      const heroLabel = document.getElementById('hero-stream-label');
      const sopTag = document.getElementById('metric-sop-tag');
      const syllabusHeading = document.getElementById('syllabus-heading');
      const syllabusSubheading = document.getElementById('syllabus-subheading');
      const patternTitle = document.getElementById('pattern-title');
      const patternTagline = document.getElementById('pattern-tagline');
      
      const gridSci = document.getElementById('grid-science');
      const gridComm = document.getElementById('grid-commerce');

      if (stream === 'commerce') {
        if (heroLabel) heroLabel.textContent = 'MAHARASHTRA STATE BOARD • COMMERCE (CODE 99)';
        if (sopTag) sopTag.textContent = 'HTML5, JS & Database';
        if (syllabusHeading) syllabusHeading.textContent = 'Class 12 IT Units (Commerce Code 99)';
        if (syllabusSubheading) syllabusSubheading.textContent = 'Maharashtra State Board chapter-wise distribution for Commerce stream.';
        if (patternTitle) patternTitle.textContent = 'HSC IT Exam Paper Pattern for Commerce (Subject Code 99)';
        if (patternTagline) patternTagline.textContent = 'Official Maharashtra Board Online Exam March 2027 Commerce Q1 to Q8 blueprint.';

        gridSci?.classList.add('hidden');
        gridComm?.classList.remove('hidden');
      } else {
        if (heroLabel) heroLabel.textContent = 'MAHARASHTRA STATE BOARD • SCIENCE (CODE 97)';
        if (sopTag) sopTag.textContent = 'HTML5, JS & PHP';
        if (syllabusHeading) syllabusHeading.textContent = 'Class 12 IT Units (Science Code 97)';
        if (syllabusSubheading) syllabusSubheading.textContent = 'Maharashtra State Board chapter-wise distribution for Science stream.';
        if (patternTitle) patternTitle.textContent = 'HSC IT Exam Paper Pattern for Science (Subject Code 97)';
        if (patternTagline) patternTagline.textContent = 'Official Maharashtra Board Online Exam March 2027 Q1 to Q8 pattern with marks.';

        gridComm?.classList.add('hidden');
        gridSci?.classList.remove('hidden');
      }
    }

    window.addEventListener('streamChange', (e) => {
      updateHomepageStream(e.detail.stream);
    });

    const currentStream = localStorage.getItem('selected_stream') || 'science';
    updateHomepageStream(currentStream);

    // Global variables to track the active session and paper
    let activeExamSessionId = null;

    function initPdfGenerators() {
      const btnPaper = document.getElementById('generate-board-pdf-btn');
      const btnKey = document.getElementById('generate-answer-key-btn');

      if (btnPaper) {
        btnPaper.addEventListener('click', async () => {
          if (typeof pdfMake === 'undefined') {
            alert('PDF generator library is still loading from CDN. Please try again in a moment.');
            return;
          }

          try {
            const activeStream = localStorage.getItem('selected_stream') || 'science';
            // Generate a unique session ID so the answer-key endpoint can pull the exact same random paper seed
            activeExamSessionId = 'pdf-sess-' + Math.random().toString(36).substring(2, 15) + Math.random().toString(36).substring(2, 15);

            const response = await fetch("/api/exam/start", {
              method: "POST",
              headers: { "Content-Type": "application/json", Accept: "application/json" },
              body: JSON.stringify({ stream: activeStream, sessionId: activeExamSessionId })
            });

            const payload = await response.json();
            if (!payload.success || !Array.isArray(payload.sections)) {
              throw new Error("Could not load exam sections from API.");
            }

            let docContent = [
              { text: "MAHARASHTRA STATE BOARD - PRACTICE EXAMINATION", style: "mainHeader" },
              { text: `Class XII - Information Technology (${activeStream.toUpperCase()})`, style: "subHeader" },
              { text: "Maximum Marks: 80 | Time: 3 Hours\n", style: "subHeader" },
              { canvas: [{ type: 'line', x1: 0, y1: 0, x2: 515, y2: 0, lineWidth: 1 }] },
              { text: "\n" }
            ];

            payload.sections.forEach(sec => {
              let subText = sec.isChoice 
                ? `[Attempt any ${sec.required || 5} out of ${sec.items.length} | Marks: ${sec.marks}]`
                : `[Marks: ${sec.marks}]`;

              docContent.push({
                text: `${sec.label}  ${subText}`,
                style: "sectionHeader"
              });

              if (sec.isChoice) {
                docContent.push({
                  text: `Attempt any ${sec.required || 5} of the following questions:`,
                  style: "instructionText"
                });
              }

              sec.items.forEach((q, idx) => {
                const qText = q.question || q.q || q.title || "Question text unavailable";
                docContent.push({ text: `${idx + 1}. ${qText}`, style: "questionText" });

                const optionsList = q.options || q.opts || [];
                if (Array.isArray(optionsList) && optionsList.length > 0) {
                  optionsList.forEach((opt, oIdx) => {
                    let label = String.fromCharCode(97 + oIdx);
                    docContent.push({ text: `     (${label}) ${opt}`, style: "optionText" });
                  });
                }

                docContent.push({ text: "", margin: [0, 3] });
              });

              docContent.push({ text: "\n" });
            });

            const docDefinition = {
              content: docContent,
              styles: {
                mainHeader: { fontSize: 16, bold: true, alignment: 'center', color: '#1f2937' },
                subHeader: { fontSize: 11, italics: true, alignment: 'center', color: '#4b5563', margin: [0, 2, 0, 8] },
                sectionHeader: { fontSize: 11, bold: true, color: '#111827', fillColor: '#f3f4f6', margin: [0, 8, 0, 4] },
                instructionText: { fontSize: 9, italics: true, color: '#6b7280', margin: [0, 0, 0, 4] },
                questionText: { fontSize: 10, bold: false, color: '#1f2937', margin: [0, 4, 0, 2] },
                optionText: { fontSize: 9, color: '#374151', margin: [12, 1, 0, 1] }
              },
              defaultStyle: { font: 'Roboto' }
            };

            pdfMake.createPdf(docDefinition).download(`HSC_IT_Board_Paper_${Date.now()}.pdf`);

            // Unlock Answer Key Button and return to original active red state
            if (btnKey) {
              btnKey.removeAttribute('disabled');
              btnKey.classList.remove('opacity-40', 'cursor-not-allowed', 'bg-slate-700');
              btnKey.classList.add('bg-rose-600', 'hover:bg-rose-500', 'shadow-rose-600/30', 'cursor-pointer');
            }
          } catch (err) {
            console.error("PDF generation error:", err);
            alert("Could not generate the board paper PDF. Please ensure the exam server is running.");
          }
        });
      }

      if (btnKey) {
        btnKey.addEventListener('click', async () => {
          if (!activeExamSessionId) return;

          try {
            const activeStream = localStorage.getItem('selected_stream') || 'science';
            const response = await fetch("/api/exam/answer-key", {
              method: "POST",
              headers: { "Content-Type": "application/json", Accept: "application/json" },
              body: JSON.stringify({ stream: activeStream, sessionId: activeExamSessionId })
            });

            const payload = await response.json();
            if (!payload.success || !Array.isArray(payload.sections)) {
              throw new Error("Could not load answer key.");
            }

            let keyContent = [
              { text: "MAHARASHTRA STATE BOARD - MODEL ANSWER KEY", style: "mainHeader" },
              { text: "Class XII - Information Technology (Official Solution Key)", style: "subHeader" },
              { text: "\n", style: "subHeader" },
              { canvas: [{ type: 'line', x1: 0, y1: 0, x2: 515, y2: 0, lineWidth: 1 }] },
              { text: "\n" }
            ];

            payload.sections.forEach(sec => {
              keyContent.push({
                text: `${sec.label} — Model Answers`,
                style: "sectionHeader"
              });

              sec.items.forEach((q, idx) => {
                const qText = q.question || q.q || q.title || "Question text unavailable";
                keyContent.push({ text: `${idx + 1}. ${qText}`, style: "questionText" });

                const ansDisplay = q.resolvedAnswer || "Refer to marking scheme.";
                keyContent.push({ text: `Correct Answer: ${ansDisplay}`, style: "answerText" });
                
                if (q.resolvedExplanation) {
                  keyContent.push({ text: `Explanation: ${q.resolvedExplanation}`, style: "explanationText" });
                }

                keyContent.push({ text: "", margin: [0, 4] });
              });

              keyContent.push({ text: "\n" });
            });

            const keyDefinition = {
              content: keyContent,
              styles: {
                mainHeader: { fontSize: 16, bold: true, alignment: 'center', color: '#0f766e' },
                subHeader: { fontSize: 11, italics: true, alignment: 'center', color: '#4b5563', margin: [0, 2, 0, 8] },
                sectionHeader: { fontSize: 11, bold: true, color: '#111827', fillColor: '#ccfbf1', margin: [0, 8, 0, 4] },
                questionText: { fontSize: 10, bold: true, color: '#1f2937', margin: [0, 4, 0, 1] },
                answerText: { fontSize: 9, bold: true, color: '#047857', margin: [10, 1, 0, 1] },
                explanationText: { fontSize: 9, italics: true, color: '#374151', margin: [10, 1, 0, 1] }
              },
              defaultStyle: { font: 'Roboto' }
            };

            pdfMake.createPdf(keyDefinition).download(`HSC_IT_Answer_Key_${Date.now()}.pdf`);
          } catch (err) {
            console.error("Answer key generation error:", err);
            alert("Could not generate the answer key PDF.");
          }
        });
      }
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initPdfGenerators);
    } else {
      initPdfGenerators();
    }
  </script>
</PortalLayout>