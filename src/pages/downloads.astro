---
import PortalLayout from '../layouts/PortalLayout.astro';

const officialTextbook = 'https://ebooks.ebalbharati.in/pdfs/1203010499.pdf';
---

<PortalLayout title="HSC IT Downloads & Official eBooks" description="Official Balbharati Information Technology textbook eBook and HSC IT revision and practical study resources.">
  <section class="mx-auto max-w-5xl px-4 py-10 pb-16 sm:px-6 sm:py-14">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <p class="mb-3 inline-flex rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1 text-xs font-bold uppercase tracking-wide text-emerald-800 dark:border-emerald-800 dark:bg-emerald-950/50 dark:text-emerald-300">Official eBooks & study assets</p>
      <h1 class="text-3xl font-black tracking-tight text-slate-900 dark:text-white sm:text-4xl">Downloads for HSC IT</h1>
      <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">Open the official Balbharati textbook PDF or browse the state eBook library for other streams, standards, and editions. Chapter notes and practical resources are available here on the portal.</p>
    </div>

    <div class="grid gap-5 md:grid-cols-2">
      <a href={officialTextbook} target="_blank" rel="noopener noreferrer" class="group rounded-2xl border border-emerald-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-500 hover:shadow-lg dark:border-emerald-900 dark:bg-slate-900">
        <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300" aria-hidden="true"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M6 2h9l5 5v13a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2Zm8 0v6h6M8 13h8m-8 4h8" /></svg></span>
        <span class="text-xs font-bold uppercase tracking-widest text-emerald-700 dark:text-emerald-400">Balbharati · PDF</span>
        <h2 class="mt-2 text-lg font-extrabold text-slate-900 group-hover:text-emerald-700 dark:text-white dark:group-hover:text-emerald-400">Std 12 Information Technology Textbook</h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Open the official state textbook PDF in a new tab.</p>
        <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-emerald-700 dark:text-emerald-400">Open PDF <span aria-hidden="true">↗</span></span>
      </a>

      <a href="https://ebooks.ebalbharati.in/" target="_blank" rel="noopener noreferrer" class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-500 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900">
        <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-slate-100 text-slate-700 dark:bg-slate-800 dark:text-slate-200" aria-hidden="true"><svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 5.5A2.5 2.5 0 0 1 6.5 3H20v16H6.5A2.5 2.5 0 0 0 4 21V5.5Zm0 0V21m4-13h8m-8 4h8" /></svg></span>
        <span class="text-xs font-bold uppercase tracking-widest text-slate-500 dark:text-slate-400">Official catalog</span>
        <h2 class="mt-2 text-lg font-extrabold text-slate-900 group-hover:text-emerald-700 dark:text-white dark:group-hover:text-emerald-400">Other streams, Std 11 & editions</h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Choose Science, Commerce, Arts, or the Std 11 reference edition directly from Balbharati’s eBook library.</p>
        <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-emerald-700 dark:text-emerald-400">Browse eBook library <span aria-hidden="true">↗</span></span>
      </a>

      <a href="/notes" class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-500 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900">
        <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-amber-50 text-amber-700 dark:bg-amber-950/50 dark:text-amber-300" aria-hidden="true">✎</span>
        <span class="text-xs font-bold uppercase tracking-widest text-amber-700 dark:text-amber-400">Portal study assets</span>
        <h2 class="mt-2 text-lg font-extrabold text-slate-900 group-hover:text-emerald-700 dark:text-white dark:group-hover:text-emerald-400">Chapter notes & model answers</h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Review concise chapter-wise notes and Q7 answer-in-brief preparation.</p>
        <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-emerald-700 dark:text-emerald-400">Browse short notes <span aria-hidden="true">→</span></span>
      </a>

      <a href="/practicals" class="group rounded-2xl border border-slate-200 bg-white p-6 shadow-sm transition hover:-translate-y-0.5 hover:border-emerald-500 hover:shadow-lg dark:border-slate-800 dark:bg-slate-900">
        <span class="mb-4 flex h-11 w-11 items-center justify-center rounded-xl bg-sky-50 text-sky-700 dark:bg-sky-950/50 dark:text-sky-300" aria-hidden="true">⌘</span>
        <span class="text-xs font-bold uppercase tracking-widest text-sky-700 dark:text-sky-400">Code 97 & 99</span>
        <h2 class="mt-2 text-lg font-extrabold text-slate-900 group-hover:text-emerald-700 dark:text-white dark:group-hover:text-emerald-400">Practical slips, SOPs & journal help</h2>
        <p class="mt-2 text-sm text-slate-600 dark:text-slate-300">Find practical programs, standard operating procedures, and journal preparation resources.</p>
        <span class="mt-5 inline-flex items-center gap-2 text-sm font-bold text-emerald-700 dark:text-emerald-400">Browse practicals <span aria-hidden="true">→</span></span>
      </a>
    </div>
  </section>
</PortalLayout>
