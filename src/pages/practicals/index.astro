---
export const prerender = true;
import PortalLayout from "../../layouts/PortalLayout.astro";
import SopCard from "../../components/SopCard.astro";

const pageTitle = "HSC IT Practicals (SOP Solutions) | Maharashtra Board Class 12";
const pageDescription = "Complete solved Skill Oriented Practical (SOP) codes, slip solutions, and viva questions for Maharashtra State Board Std 12 Information Technology (Science & Commerce).";
const pageKeywords = "HSC IT practicals, Std 12 IT SOP solutions, Advanced Web Designing SOP, JavaScript form validation practical, PHP SOP slips, LibreOffice Base SOP, Class 12 IT journal solutions, HSC IT practical marks distribution 2027";

const groupASOPs = [
  { sop: "SOP 1", category: "Advanced Web Designing", title: "Creation of Website using HTML5", description: "Two-page website with meta tags, a centred heading, physical tags, an image with alt text, navigation links and an HTML5 feedback form.", tech: "HTML5 + CSS", href: "/practicals/group-a#sop-1" },
  { sop: "SOP 2", category: "Advanced Web Designing", title: "Tourist Places Layout", description: "Layout with a header, city list and tourist places, using an inline style for the top section and an internal stylesheet for the sides.", tech: "HTML + CSS Layout", href: "/practicals/group-a#sop-2" },
  { sop: "SOP 3", category: "Advanced Web Designing", title: "Traveller Booking Pages", description: "Interlinked pages: a form with an image submit button and a details page with an unordered list, styled with an external stylesheet.", tech: "External CSS", href: "/practicals/group-a#sop-3" },
  { sop: "SOP 4", category: "Advanced Web Designing", title: "News Page Layout", description: "Webpage layout built with nav, header, article, aside and footer tags and CSS.", tech: "HTML5 Semantic Tags", href: "/practicals/group-a#sop-4" },
  { sop: "SOP 5", category: "Advanced Web Designing", title: "Use of Audio on Web Pages using HTML5", description: "Single audio file with controls, autoplay and loop, plus multiple source formats (mp3, ogg, wav) with a fallback message.", tech: "HTML5 Audio", href: "/practicals/group-a#sop-5" },
  { sop: "SOP 6", category: "Advanced Web Designing", title: "Use of Video on Web Pages using HTML5", description: "Single video (150 × 150) and multiple source formats (mp4, webm, ogg, 100 × 100) with controls, autoplay and a fallback message.", tech: "HTML5 Video", href: "/practicals/group-a#sop-6" },
];

// Group B (Science): codes live on the Q8 vault page for now.
const scienceGroupB = [
  { sop: "SOP B1", category: "Advanced JavaScript", title: "Form Validation using JavaScript", description: "Validate user input (Name, Age, Email, Mobile number) using client-side JavaScript regex, event listeners, and alert/focus states.", tech: "JavaScript DOM", href: "/q8-vault" },
  { sop: "SOP B2", category: "Advanced JavaScript", title: "Mathematical Computations & String Manipulation", description: "Calculate square roots, absolute values, string lengths, and conversions using JavaScript built-in Math and String objects.", tech: "Math & String Objects", href: "/q8-vault" },
  { sop: "SOP B3", category: "Server-Side Scripting (PHP)", title: "PHP Form Processing using POST & GET", description: "Capture user input from an HTML form, sanitize input parameters, and display formatted output dynamically using $_POST.", tech: "PHP POST/GET", href: "/q8-vault" },
  { sop: "SOP B4", category: "Server-Side Scripting (PHP)", title: "PHP Arrays & User-Defined Functions", description: "Sort associative arrays, calculate averages, and write reusable user functions with argument passing and return statements.", tech: "PHP Arrays & Functions", href: "/q8-vault" },
];

const pageSchema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Maharashtra HSC Std 12 IT Practical Solutions (SOP)",
  "description": pageDescription,
  "provider": { "@type": "Organization", "name": "HSC IT Portal" }
};
---

<PortalLayout 
  title={pageTitle} 
  description={pageDescription} 
  keywords={pageKeywords}
  schemaData={pageSchema}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 sm:py-14 space-y-10 sm:space-y-12">
    
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950 border border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 text-xs font-mono font-bold uppercase">
        <span>🧪 Lab Practical Handbook • 20 Marks Total Weightage</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Class 12 IT Skill Oriented Practicals (SOP)
      </h1>
      <p class="text-sm sm:text-base text-slate-600 dark:text-slate-400">
        Official Maharashtra Board SOP specimen codes, journal slips, and viva voce question sets.
      </p>
    </div>

    <section 
      id="exam-structure" 
      class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 p-6 sm:p-10 shadow-sm space-y-6"
    >
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-slate-100 dark:border-slate-800 pb-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-100 dark:bg-emerald-950 border border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300 font-mono text-xs font-bold uppercase tracking-wider mb-2">
            <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
            Official Board Guidelines
          </div>
          <h2 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-slate-900 dark:text-white">
            HSC IT PRACTICAL EXAM  2027 : MARKS DISTRIBUTION
          </h2>
          <p class="text-xs sm:text-sm text-slate-600 dark:text-slate-400 mt-1">
            Internal Evaluation Scheme conducted at College Examination Centers across Maharashtra.
          </p>
        </div>

        <div class="flex items-center gap-3">
          <div class="px-5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 text-center">
            <p class="text-[10px] font-mono text-slate-500 dark:text-slate-400 uppercase font-bold">Total Marks</p>
            <p class="text-2xl font-black text-emerald-600 dark:text-emerald-400">20</p>
          </div>
          <div class="px-5 py-2.5 rounded-xl bg-slate-50 dark:bg-slate-800/80 border border-slate-200 dark:border-slate-700/80 text-center">
            <p class="text-[10px] font-mono text-slate-500 dark:text-slate-400 uppercase font-bold">Duration</p>
            <p class="text-2xl font-black text-slate-900 dark:text-white">1 Hr</p>
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        <div class="rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/80 p-5 sm:p-6 space-y-4">
          <div class="flex items-center justify-between">
            <h3 class="font-extrabold text-base text-slate-900 dark:text-white">
              💻 College Lab Practical Exam
            </h3>
            <span class="font-mono text-xs font-bold px-2.5 py-1 rounded bg-emerald-100 dark:bg-emerald-950 border border-emerald-300 dark:border-emerald-800 text-emerald-800 dark:text-emerald-300">
              15 Marks
            </span>
          </div>
          <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
            Every candidate is allotted an individual lab computer and a printed question slip containing practical problems.
          </p>

          <div class="space-y-2.5 pt-1">
            <div class="flex items-center justify-between text-xs p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700/80">
              <div>
                <p class="font-bold text-slate-900 dark:text-white text-sm">Handwritten Code / Solution Steps</p>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Written on the official board practical answer sheet</p>
              </div>
              <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400 text-sm whitespace-nowrap pl-2">5 Marks</span>
            </div>

            <div class="flex items-center justify-between text-xs p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700/80">
              <div>
                <p class="font-bold text-slate-900 dark:text-white text-sm">Correct Typing & Syntax on Computer</p>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Typing program into editor with proper tags / commands</p>
              </div>
              <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400 text-sm whitespace-nowrap pl-2">5 Marks</span>
            </div>

            <div class="flex items-center justify-between text-xs p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700/80">
              <div>
                <p class="font-bold text-slate-900 dark:text-white text-sm">Execution & Output Verification</p>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Rendering form/browser output & examiner verification</p>
              </div>
              <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400 text-sm whitespace-nowrap pl-2">3 Marks</span>
            </div>

            <div class="flex items-center justify-between text-xs p-3 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700/80">
              <div>
                <p class="font-bold text-slate-900 dark:text-white text-sm">Practical Printout Submission</p>
                <p class="text-[11px] text-slate-500 dark:text-slate-400 mt-0.5">Printout with Candidate Board Seat Number embedded</p>
              </div>
              <span class="font-mono font-bold text-emerald-600 dark:text-emerald-400 text-sm whitespace-nowrap pl-2">2 Marks</span>
            </div>
          </div>
        </div>

        <div class="rounded-2xl bg-slate-50 dark:bg-slate-800/50 border border-slate-200 dark:border-slate-700/80 p-5 sm:p-6 space-y-4 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between">
              <h3 class="font-extrabold text-base text-slate-900 dark:text-white">
                📖 Certified Journal & Viva
              </h3>
              <span class="font-mono text-xs font-bold px-2.5 py-1 rounded bg-teal-100 dark:bg-teal-950 border border-teal-300 dark:border-teal-800 text-teal-800 dark:text-teal-300">
                5 Marks
              </span>
            </div>
            <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed mt-2">
              Mandatory lab record book carrying sign-offs from the junior college subject teacher and external examiner.
            </p>

            <div class="mt-4 p-4 rounded-xl bg-white dark:bg-slate-900 border border-slate-200 dark:border-slate-700/80 space-y-2">
              <div class="flex items-center justify-between text-xs">
                <span class="font-bold text-slate-900 dark:text-white text-sm">Certified IT Journal / Handbook</span>
                <span class="font-mono font-bold text-teal-600 dark:text-teal-300 text-sm">5 Marks</span>
              </div>
              <p class="text-xs text-slate-600 dark:text-slate-300 leading-relaxed">
                Requires neat handwriting, completed program printouts, correct flowchart diagrams, and the principal/teacher certificate stamp.
              </p>
            </div>
          </div>

          <div class="p-4 rounded-xl bg-emerald-50 dark:bg-emerald-950/60 border border-emerald-300 dark:border-emerald-800 flex items-center justify-between mt-4">
            <div>
              <p class="text-xs font-bold text-slate-900 dark:text-white">Final Practical Total</p>
              <p class="text-[11px] text-emerald-700 dark:text-emerald-300">15 Marks Lab + 5 Marks Journal</p>
            </div>
            <span class="font-mono text-xl font-extrabold text-emerald-600 dark:text-emerald-400">20 / 20</span>
          </div>
        </div>
      </div>
    </section>

    <div id="sop-grid-groupa" class="space-y-6 pt-4">
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
        <div>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">Group A: HTML5 & CSS Practicals (Science & Commerce)</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">Advanced Web Designing: common to both streams</p>
        </div>
        <span class="text-xs font-mono font-bold px-2.5 py-1 rounded bg-emerald-100 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200 border border-emerald-300 dark:border-emerald-700">
          6 Solved SOPs
        </span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {groupASOPs.map((s) => <SopCard {...s} />)}
      </div>
    </div>

    <div id="sop-grid-science" class="space-y-6 pt-4">
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
        <div>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">Group B: Science Stream (Subject Code 97)</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">Advanced JavaScript & PHP Server-Side Scripting</p>
        </div>
        <span class="text-xs font-mono font-bold px-2.5 py-1 rounded bg-emerald-100 dark:bg-emerald-900 text-emerald-800 dark:text-emerald-200 border border-emerald-300 dark:border-emerald-700">
          4 Solved SOPs
        </span>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {scienceGroupB.map((s) => <SopCard {...s} />)}
      </div>
    </div>

    <div id="sop-grid-commerce" class="hidden space-y-6 pt-4">
      <div class="flex items-center justify-between border-b border-slate-200 dark:border-slate-800 pb-3">
        <div>
          <h2 class="text-xl font-bold text-slate-900 dark:text-white">Group B: Commerce Stream (Subject Code 99)</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">Tally practicals</p>
        </div>
        <span class="text-xs font-mono font-bold px-2.5 py-1 rounded bg-slate-100 dark:bg-slate-800 text-slate-600 dark:text-slate-300 border border-slate-200 dark:border-slate-700">
          Coming soon
        </span>
      </div>
      <div class="rounded-2xl border border-dashed border-slate-300 dark:border-slate-700 bg-white dark:bg-slate-900 p-6 text-sm text-slate-600 dark:text-slate-400">
        Tally SOP solutions for the Commerce stream will be added here soon. Group A above applies to you as well.
      </div>
    </div>

  </div>

  <script is:inline>
    function updateSOPStream(stream) {
      const sciGrid = document.getElementById('sop-grid-science');
      const commGrid = document.getElementById('sop-grid-commerce');

      if (stream === 'commerce') {
        if (sciGrid) sciGrid.classList.add('hidden');
        if (commGrid) commGrid.classList.remove('hidden');
      } else {
        if (commGrid) commGrid.classList.add('hidden');
        if (sciGrid) sciGrid.classList.remove('hidden');
      }
    }

    window.addEventListener('streamChange', (e) => {
      updateSOPStream(e.detail?.stream);
    });

    const activeStream = localStorage.getItem('selected_stream') || 'science';
    updateSOPStream(activeStream);
  </script>
</PortalLayout>