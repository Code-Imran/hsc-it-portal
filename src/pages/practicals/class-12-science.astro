---
import PortalLayout from "../../layouts/PortalLayout.astro";

const syllabusSops = [
  { group: "Group A: Web Designing (Ch. 1)", title: "SOP 1: Two-page website linking with CSS formatting & enrolment form" },
  { group: "Group A: Web Designing (Ch. 1)", title: "SOP 2: Multi-section layout with CSS Flexbox & navigation bars" },
  { group: "Group A: Web Designing (Ch. 1)", title: "SOP 3: Travel reservation system (Two-page form & unordered list itinerary)" },
  { group: "Group A: Web Designing (Ch. 1)", title: "SOP 4: Semantic webpage structuring (<header>, <nav>, <section>, <article>, <aside>, <footer>)" },
  { group: "Group A: Web Designing (Ch. 1)", title: "SOP 5: Embedding audio (<audio> and <source> with controls, loop)" },
  { group: "Group A: Web Designing (Ch. 1)", title: "SOP 6: Embedding video (<video> with width, height, poster, controls)" },
  { group: "Group A: Web Designing (Ch. 1)", title: "SOP 7: Client-side image mapping (<map>, <area> with rect, circle, poly)" },
  { group: "Group B: JavaScript (Ch. 3)", title: "SOP 1: Dynamic background color switcher (onclick, onmouseover)" },
  { group: "Group B: JavaScript (Ch. 3)", title: "SOP 2: Form validation (Name, 10-digit mobile, Email regex/indexOf)" },
  { group: "Group B: JavaScript (Ch. 3)", title: "SOP 3: Vowel counter in user-entered string" },
  { group: "Group B: JavaScript (Ch. 3)", title: "SOP 4: Dynamic temperature converter (Celsius ↔ Fahrenheit)" },
  { group: "Group B: JavaScript (Ch. 3)", title: "SOP 5: String/number palindrome verification" },
  { group: "Group B: JavaScript (Ch. 3)", title: "SOP 6: Student aggregate marks, percentage, and grade ladder" },
  { group: "Group B: PHP Scripting (Ch. 5)", title: "SOP 1: Voting eligibility checker (Age >= 18 function)" },
  { group: "Group B: PHP Scripting (Ch. 5)", title: "SOP 2: Vowel counter using PHP string functions" },
  { group: "Group B: PHP Scripting (Ch. 5)", title: "SOP 3: Student marks & percentage using associative arrays" }
];

const practicalCards = [
  {
    id: "practical-group-a",
    badge: "Group A • 15 Marks",
    category: "Chapter 1: Advanced Web Designing",
    title: "SOP 5 & 7: Audio, Video & Client-Side Image Mapping",
    tabTitle: "HSC IT Science - Group A Media & Image Mapping",
    filename: "media_mapping.html",
    fileUrl: "file:///C:/HSC_IT_2027/media_mapping.html",
    videoUrl: "#",
    aim: "Create an HTML5 web page embedding audio with controls and loop attributes, video with player controls and poster, and implement client-side image mapping (<map>, <area>, usemap) with rectangular and circular clickable hotspot regions.",
    code: `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>HSC IT Science - Group A Media & Image Mapping</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 20px; background-color: #f7fafc; color: #2d3748; }
        header { background-color: #059669; color: white; padding: 15px; text-align: center; border-radius: 6px; }
        .section-box { background: white; border: 1px solid #e2e8f0; border-radius: 8px; padding: 20px; margin-top: 15px; }
        h2 { color: #059669; border-bottom: 2px solid #edf2f7; padding-bottom: 5px; }
    </style>
</head>
<body>

    <header>
        <h1>Skill Oriented Practical: Group A</h1>
        <p>HTML5 Multimedia & Client-Side Image Mapping</p>
    </header>

    <!-- Audio & Video Integration -->
    <div class="section-box">
        <h2>1. HTML5 Audio & Video Controls</h2>
        
        <h3>Audio Player</h3>
        <audio controls loop>
            <source src="sample.mp3" type="audio/mpeg">
            Your browser does not support the audio element.
        </audio>

        <h3>Video Player</h3>
        <video width="320" height="240" controls poster="poster.jpg">
            <source src="sample.mp4" type="video/mp4">
            Your browser does not support the video element.
        </video>
    </div>

    <!-- Client-Side Image Mapping -->
    <div class="section-box">
        <h2>2. Client-Side Image Mapping</h2>
        <p>Click on the designated regions of the image below:</p>
        
        <img src="shapes.png" alt="Geometric Navigation Map" usemap="#geomap" width="400" height="200">
        
        <map name="geomap">
            <area shape="rect" coords="20,20,120,120" href="https://www.google.com" alt="Google Search" target="_blank">
            <area shape="circle" coords="220,70,50" href="https://www.wikipedia.org" alt="Wikipedia" target="_blank">
        </map>
    </div>

</body>
</html>`,
    outputSummary: "Demonstrates audio playback with loop support, responsive video rendering with preview poster, and client-side geometric hotspots linked to destination URLs."
  },
  {
    id: "practical-group-b-js",
    badge: "Group B • Option 1 • 15 Marks",
    category: "Chapter 3: Advanced JavaScript",
    title: "SOP 3 & 5: JavaScript Vowel Counter & String Palindrome Checker",
    tabTitle: "HSC IT Science - Group B JavaScript",
    filename: "js_practical.html",
    fileUrl: "file:///C:/HSC_IT_2027/js_practical.html",
    videoUrl: "#",
    aim: "Write event-driven JavaScript functions to: (1) calculate the total count of vowels (a, e, i, o, u) in a user-provided string using string indexing, and (2) verify whether a given string or number is a Palindrome through string reversal logic.",
    code: `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>HSC IT Science - Group B JavaScript</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 30px; background-color: #edf2f7; }
        .card { background: white; padding: 20px; border-radius: 8px; width: 380px; box-shadow: 0 4px 6px rgba(0,0,0,0.1); margin-bottom: 20px; }
        input[type="text"] { width: 90%; padding: 8px; margin: 8px 0; border: 1px solid #cbd5e0; border-radius: 4px; }
        button { padding: 8px 16px; background-color: #059669; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; }
        button:hover { background-color: #047857; }
        .result { margin-top: 10px; font-weight: bold; color: #2d3748; }
    </style>
    <script>
        function countVowels() {
            var str = document.getElementById("vowelInput").value.toLowerCase();
            var count = 0;
            var vowels = "aeiou";

            for (var i = 0; i < str.length; i++) {
                if (vowels.indexOf(str[i]) !== -1) {
                    count++;
                }
            }
            document.getElementById("vowelResult").innerHTML = "Total Vowels: " + count;
        }

        function checkPalindrome() {
            var inputStr = document.getElementById("palInput").value.trim().toLowerCase();
            if (inputStr === "") {
                alert("Please enter a string/number.");
                return;
            }
            var reversed = inputStr.split("").reverse().join("");
            var resBox = document.getElementById("palResult");

            if (inputStr === reversed) {
                resBox.innerHTML = "<span style='color: #059669;'>'" + inputStr + "' is a Palindrome!</span>";
            } else {
                resBox.innerHTML = "<span style='color: #dc2626;'>'" + inputStr + "' is NOT a Palindrome.</span>";
            }
        }
    </script>
</head>
<body>

    <div class="card">
        <h3>SOP 3: Count Total Vowels</h3>
        <input type="text" id="vowelInput" placeholder="Enter a sentence or word">
        <br>
        <button onclick="countVowels()">Calculate Vowels</button>
        <div id="vowelResult" class="result"></div>
    </div>

    <div class="card">
        <h3>SOP 5: Palindrome Verification</h3>
        <input type="text" id="palInput" placeholder="e.g. radar or 12321">
        <br>
        <button onclick="checkPalindrome()">Verify Palindrome</button>
        <div id="palResult" class="result"></div>
    </div>

</body>
</html>`,
    outputSummary: "Calculates total vowel frequency across user strings and verifies string palindromes via array reverse and split/join string manipulation."
  },
  {
    id: "practical-group-b-php",
    badge: "Group B • Option 2 • 15 Marks",
    category: "Chapter 5: Server-Side Scripting (PHP)",
    title: "SOP 1 & 3: PHP Voting Eligibility Function & Associative Array Marks Sheet",
    tabTitle: "HSC IT Science - PHP SOP 1 & SOP 3",
    filename: "science_php.php",
    fileUrl: "http://localhost/hsc_it/science_php.php",
    videoUrl: "#",
    aim: "Write a server-side PHP script with: (1) a user-defined function to determine voting eligibility (Age >= 18) via POST processing, and (2) an associative array storing 5 science subject marks to compute the grand total and aggregate percentage.",
    code: `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>HSC IT Science - PHP SOP 1 & SOP 3</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 30px; background: #fafafa; }
        .box { background: white; padding: 20px; border: 1px solid #ddd; width: 420px; border-radius: 6px; margin-bottom: 20px; }
        input[type="number"], input[type="text"] { width: 90%; padding: 6px; margin-bottom: 10px; }
        input[type="submit"] { background: #059669; color: white; border: none; padding: 8px 16px; border-radius: 4px; cursor: pointer; font-weight: bold; }
    </style>
</head>
<body>

    <!-- PHP SOP 1: Check Voting Eligibility -->
    <div class="box">
        <h3>SOP 1: Voting Eligibility Checker</h3>
        <form method="post" action="">
            <label>Enter Person's Age:</label><br>
            <input type="number" name="age" required min="1" max="120" placeholder="e.g. 19">
            <br>
            <input type="submit" name="check_vote" value="Check Eligibility">
        </form>

        <?php
        function checkEligibility($age) {
            if ($age >= 18) {
                return "<p style='color:#059669; font-weight:bold;'>Eligible to Vote (Age: $age years).</p>";
            } else {
                $rem = 18 - $age;
                return "<p style='color:#dc2626; font-weight:bold;'>Not Eligible to Vote. Wait $rem more year(s).</p>";
            }
        }

        if (isset($_POST['check_vote'])) {
            $userAge = intval($_POST['age']);
            echo checkEligibility($userAge);
        }
        ?>
    </div>

    <!-- PHP SOP 3: Array Total & Percentage Calculation -->
    <div class="box">
        <h3>SOP 3: Student Marks Using Array</h3>
        <?php
        $marks = array(
            "Physics" => 78,
            "Chemistry" => 85,
            "Mathematics" => 92,
            "Information Technology" => 96,
            "English" => 81
        );

        $totalMarks = 0;
        $numSubjects = count($marks);

        echo "<ul>";
        foreach ($marks as $subject => $score) {
            echo "<li><strong>$subject:</strong> $score / 100</li>";
            $totalMarks += $score;
        }
        echo "</ul>";

        $percentage = $totalMarks / $numSubjects;

        echo "<p><strong>Total Marks Obtained:</strong> $totalMarks / " . ($numSubjects * 100) . "</p>";
        echo "<p><strong>Calculated Percentage:</strong> " . number_format($percentage, 2) . "%</p>";
        ?>
    </div>

</body>
</html>`,
    outputSummary: "Processes server-side form submissions through $_POST, applies user-defined boolean validation, iterates associative arrays using foreach loops, and calculates aggregate percentages."
  }
];

const vivaQuestions = [
  {
    num: "01",
    q: "Why is the 'usemap' attribute prefixed with a hash (#) symbol in HTML5?",
    a: "The '#' symbol indicates that the map name refers to an internal client-side anchor element (<map name='...'>) defined within the same HTML document, distinguishing it from an external URL file."
  },
  {
    num: "02",
    q: "What are the geometric shapes supported by the <area> tag and their required coordinates?",
    a: "1) rect (shape='rect', coords='x1, y1, x2, y2' - top-left & bottom-right corners), 2) circle (shape='circle', coords='center_x, center_y, radius'), and 3) poly (shape='poly', coords='x1, y1, x2, y2, x3, y3...' - all vertex coordinates)."
  },
  {
    num: "03",
    q: "What is the fundamental difference between Client-Side Scripting and Server-Side Scripting?",
    a: "Client-side scripts (JavaScript) execute locally inside the user's web browser, saving server bandwidth and providing instantaneous feedback. Server-side scripts (PHP) execute entirely on the web server before returning pure HTML to the client, providing database connectivity and securing sensitive business logic."
  },
  {
    num: "04",
    q: "What is the difference between $_GET and $_POST methods in PHP?",
    a: "$_GET sends data appended directly to the URL query string (visible in the address bar with an 8 KB limit; not suitable for passwords). $_POST transmits parameters within the HTTP request body invisibly, has no strict URL size limitations, and is secure for authentication."
  },
  {
    num: "05",
    q: "When does the JavaScript function isNaN() return false?",
    a: "isNaN() stands for 'is Not a Number'. It returns false when the argument is a valid numeric value (e.g., isNaN(123) is false; isNaN('123') is false). It returns true when the value cannot be parsed as a number."
  },
  {
    num: "06",
    q: "What is the difference between innerHTML and textContent / value in JavaScript DOM?",
    a: "'value' is used to get or set data typed into form inputs (<input>, <textarea>). 'innerHTML' gets or renders HTML tags and markup inside container elements (<div>, <p>). 'textContent' parses and returns purely raw text without rendering any HTML tags."
  },
  {
    num: "07",
    q: "Name four new HTML5 form input types and their validation benefits.",
    a: "1) type='email' (enforces RFC email format with '@' and domain), 2) type='tel' (works with 'pattern' attribute for 10-digit mobile numbers), 3) type='date' (displays interactive calendar picker), 4) type='number' (restricts input to digits with 'min' and 'max')."
  },
  {
    num: "08",
    q: "What is the role of 'autofocus' and 'required' attributes in HTML5 forms?",
    a: "'autofocus' automatically places the cursor inside the specified input field as soon as the page loads. 'required' prevents form submission if the input field is left empty by the student."
  },
  {
    num: "09",
    q: "How does an indexed array differ from an associative array in PHP?",
    a: "An indexed array uses automatic zero-based numeric keys ($arr[0], $arr[1]). An associative array uses custom named string keys mapped to values ($arr = array('Physics' => 78, 'Chemistry' => 85))."
  },
  {
    num: "10",
    q: "Which PHP built-in function is used to calculate the length of a string, and how does it differ from str_word_count()?",
    a: "'strlen($str)' counts the total number of characters including spaces and punctuation. 'str_word_count($str)' parses the sentence and returns only the total count of recognized words."
  },
  {
    num: "11",
    q: "What is On-Page SEO vs Off-Page SEO in Chapter 2?",
    a: "On-Page SEO involves optimizing website elements directly under the creator's control (meta tags, title tags, heading hierarchy <h1>-<h6>, image alt text, clean URLs). Off-Page SEO involves external reputation building (backlinks, social media sharing, domain authority)."
  },
  {
    num: "12",
    q: "Under the Information Technology Act 2000, what is Section 66?",
    a: "Section 66 deals with computer-related offenses, hacking, identity theft, unauthorized data access, and fraud, providing penalties of up to 3 years imprisonment and/or fines up to ₹5 lakh."
  }
];
---

<PortalLayout title="Class 12 Science IT Board Practicals">
  <section class="max-w-5xl mx-auto px-4 sm:px-6 py-12">
    
    <!-- Header Banner -->
    <div class="mb-10 text-center max-w-3xl mx-auto">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-800 dark:text-emerald-300 text-xs font-mono font-bold tracking-tight mb-4">
        <span>🧪</span> Maharashtra Board Class 12 Science (Code 97)
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 dark:text-white tracking-tight">
        Science Skill Oriented Practicals (SOP)
      </h1>
      <p class="text-sm text-slate-600 dark:text-slate-400 mt-2 leading-relaxed">
        Official Balbharati Class 12 Science IT practical curriculum: Complete syllabus breakdown across Chapter 1 (Web Designing), Chapter 3 (JavaScript), and Chapter 5 (Server-Side PHP) with working source code, browser output specimens, and external viva preparation.
      </p>
    </div>

    <!-- Official HSC Practical Exam Mark Scheme Callout -->
    <div class="rounded-2xl border border-emerald-200 dark:border-emerald-500/30 bg-emerald-50/60 dark:bg-emerald-950/20 p-5 sm:p-6 mb-10 shadow-sm">
      <div class="flex items-center justify-between mb-3">
        <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-800 dark:text-emerald-300">
          Official Practical Slip Distribution (Total: 50 Marks)
        </span>
        <span class="text-xs font-mono font-bold bg-emerald-600 text-white px-2.5 py-0.5 rounded-full">
          HSC Board Standard
        </span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-xs">
        <div class="bg-white dark:bg-slate-900 p-3 rounded-xl border border-slate-200 dark:border-slate-800">
          <p class="text-slate-400 font-mono text-[10px]">GROUP A QUESTION</p>
          <p class="font-bold text-slate-900 dark:text-white text-base mt-0.5">15 Marks</p>
          <span class="text-[11px] text-slate-500">Advanced Web Designing</span>
        </div>
        <div class="bg-white dark:bg-slate-900 p-3 rounded-xl border border-slate-200 dark:border-slate-800">
          <p class="text-slate-400 font-mono text-[10px]">GROUP B QUESTION</p>
          <p class="font-bold text-slate-900 dark:text-white text-base mt-0.5">15 Marks</p>
          <span class="text-[11px] text-slate-500">JavaScript OR PHP Script</span>
        </div>
        <div class="bg-white dark:bg-slate-900 p-3 rounded-xl border border-slate-200 dark:border-slate-800">
          <p class="text-slate-400 font-mono text-[10px]">CERTIFIED JOURNAL</p>
          <p class="font-bold text-slate-900 dark:text-white text-base mt-0.5">10 Marks</p>
          <span class="text-[11px] text-slate-500">Signed Science Workbook</span>
        </div>
        <div class="bg-white dark:bg-slate-900 p-3 rounded-xl border border-slate-200 dark:border-slate-800">
          <p class="text-slate-400 font-mono text-[10px]">ORAL VIVA VOCE</p>
          <p class="font-bold text-slate-900 dark:text-white text-base mt-0.5">10 Marks</p>
          <span class="text-[11px] text-slate-500">External Examiner</span>
        </div>
      </div>
    </div>

    <!-- Complete Balbharati Science SOP Index Table -->
    <div class="p-5 sm:p-6 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 mb-12 shadow-sm">
      <div class="flex items-center justify-between mb-4">
        <div>
          <h2 class="text-base font-bold text-slate-900 dark:text-white">Official Balbharati Syllabus SOP Checklist</h2>
          <p class="text-xs text-slate-500 dark:text-slate-400">All 16 practical tasks prescribed across Chapters 1, 3, and 5.</p>
        </div>
        <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400">Code 97</span>
      </div>

      <div class="space-y-2 text-xs">
        {syllabusSops.map((item, idx) => (
          <div class="p-2.5 rounded-lg border border-slate-100 dark:border-slate-800/80 bg-slate-50/50 dark:bg-slate-950/40 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div class="flex items-center gap-2">
              <span class="font-mono text-slate-400 text-[11px] w-6">{(idx + 1).toString().padStart(2, '0')}.</span>
              <span class="font-medium text-slate-800 dark:text-slate-200">{item.title}</span>
            </div>
            <span class="text-[10px] font-mono font-bold text-emerald-700 dark:text-emerald-300 px-2 py-0.5 rounded bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 shrink-0">
              {item.group}
            </span>
          </div>
        ))}
      </div>
    </div>

    <!-- Section Heading for Working Solutions -->
    <div class="mb-8">
      <span class="text-xs font-mono font-bold uppercase tracking-wider text-emerald-600 dark:text-emerald-400">Board Exam Slips & Solutions</span>
      <h2 class="text-2xl font-extrabold text-slate-900 dark:text-white mt-1">Most Repeated XII Science Practicals: Code & Windows Chrome Outputs</h2>
      <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Ready-to-print browser snapshots simulating an authentic Google Chrome session on Windows 11 lab PCs.</p>
    </div>

    <!-- Practical Solution Cards -->
    <div class="space-y-16">
      {practicalCards.map((card) => (
        <article id={card.id} class="rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-md overflow-hidden transition-all">
          
          <!-- Card Header with Action Buttons -->
          <div class="p-6 border-b border-slate-100 dark:border-slate-800/80 bg-slate-50/60 dark:bg-slate-950/40 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2">
                <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400 uppercase">
                  {card.category}
                </span>
                <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-100 dark:bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 font-bold">
                  {card.badge}
                </span>
              </div>
              <h3 class="text-lg sm:text-xl font-bold text-slate-900 dark:text-white mt-1">
                {card.title}
              </h3>
            </div>
            
            <!-- Button Group: Video Tutorial + Copy Solution -->
            <div class="flex items-center gap-2.5 flex-wrap">
              <a 
                href={card.videoUrl} 
                target={card.videoUrl !== '#' ? "_blank" : undefined}
                rel={card.videoUrl !== '#' ? "noopener noreferrer" : undefined}
                class="video-btn px-3.5 py-2 rounded-lg border border-rose-200 dark:border-rose-900/40 bg-rose-50 dark:bg-rose-950/30 hover:bg-rose-100 dark:hover:bg-rose-900/50 text-rose-700 dark:text-rose-300 font-semibold text-xs transition shadow-sm flex items-center justify-center gap-1.5 cursor-pointer shrink-0 group"
                title={card.videoUrl === '#' ? "Video tutorial being recorded" : "Watch tutorial"}
              >
                <svg class="w-4 h-4 text-rose-600 dark:text-rose-400 transition group-hover:scale-110" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M8 5v14l11-7z" />
                </svg>
                <span>Watch Video Tutorial</span>
              </a>

              <button 
                type="button" 
                class="copy-btn px-3.5 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-500 text-white font-semibold text-xs transition shadow-sm flex items-center justify-center gap-1.5 cursor-pointer shrink-0"
                data-code={card.code}
              >
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
                </svg>
                <span>Copy Solution Code</span>
              </button>
            </div>
          </div>

          <div class="p-6 space-y-6">
            <div>
              <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400 mb-1">Practical Aim & Objective</h4>
              <p class="text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed font-medium bg-slate-50 dark:bg-slate-950/60 p-3.5 rounded-xl border border-slate-200/80 dark:border-slate-800">
                {card.aim}
              </p>
            </div>

            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400">
                  Save as: <strong class="text-slate-700 dark:text-slate-200">{card.filename}</strong>
                </span>
                <span class="text-[11px] font-mono text-emerald-600 dark:text-emerald-400 font-bold">Standard UTF-8</span>
              </div>
              <div class="rounded-xl bg-slate-950 p-4 border border-slate-800 overflow-x-auto shadow-inner">
                <pre class="text-xs font-mono text-emerald-400 leading-relaxed"><code>{card.code}</code></pre>
              </div>
            </div>

