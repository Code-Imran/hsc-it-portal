                    <span class="inline-block w-2 h-2 rounded-full bg-emerald-500"></span>
                    <span>Commerce Practical Printed Output Certified by Internal Examiner</span>
                  </div>
                  <div class="flex items-center gap-3">
                    <span class="text-slate-400">Date of Exam: March 2027</span>
                    <span class="font-bold text-emerald-600 dark:text-emerald-400">Scale: 15 / 15 Marks</span>
                  </div>
                </div>

              </div>
            </div>

            <!-- Execution & Submission Checklist -->
            <div class="pt-4 border-t border-slate-100 dark:border-slate-800">
              <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-slate-400 mb-1.5">Output Verification &amp; Submission Checklist</h4>
              <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                {sop.outputSummary} Print this browser snapshot window alongside your source code to fulfill Maharashtra State Board external evaluation requirements.
              </p>
            </div>
          </div>

        </article>
      ))}
    </div>

  </section>

  <!-- Interactive Copy & Video Prompt Script -->
  <script is:inline>
    document.querySelectorAll('.copy-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const code = btn.getAttribute('data-code');
        if (!code) return;

        try {
          await navigator.clipboard.writeText(code);
          const originalText = btn.innerHTML;
          btn.innerHTML = `
            <svg class="w-4 h-4 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
            <span>Copied to Clipboard!</span>
          `;
          btn.classList.add('bg-teal-600');
          setTimeout(() => {
            btn.innerHTML = originalText;
            btn.classList.remove('bg-teal-600');
          }, 2000);
        } catch (err) {
          console.error("Clipboard copy failed: ", err);
        }
      });
    });

    document.querySelectorAll('.video-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        if (btn.getAttribute('href') === '#') {
          e.preventDefault();
          alert("Commerce video tutorial is being recorded and will be published shortly!");
        }
      });
    });
  </script>
</PortalLayout>