---
import PortalLayout from "../layouts/PortalLayout.astro";
---

<PortalLayout title="404 — Page Under Preparation">
  <section class="max-w-3xl mx-auto px-6 py-20 text-center">
    <!-- Notice Badge -->
    <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-emerald-800 dark:text-emerald-300 text-xs font-mono font-bold tracking-tight mb-6">
      <span class="h-2 w-2 rounded-full bg-emerald-500"></span>
      Maharashtra Board IT (Code 97)
    </div>

    <!-- Big Simple Status -->
    <h1 class="text-7xl sm:text-8xl font-extrabold text-slate-900 dark:text-white tracking-tight font-mono mb-4">
      404
    </h1>

    <h2 class="text-2xl sm:text-3xl font-bold text-slate-900 dark:text-white mb-3">
      Page Not Found or Under Preparation
    </h2>

    <p class="text-base text-slate-600 dark:text-slate-400 max-w-lg mx-auto leading-relaxed mb-10">
      The study resource or topic you are looking for has either moved or is currently being compiled for the upcoming <strong>March 2027</strong> board exam syllabus.
    </p>

    <!-- Clear, Direct Action Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 text-left mb-10">
      
      <a href="/" class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:border-emerald-500 transition group flex flex-col justify-between">
        <div>
          <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400">Home</span>
          <h3 class="font-bold text-slate-900 dark:text-white text-sm mt-1 group-hover:text-emerald-600 transition">
            Syllabus & Weightage
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Review chapter-wise marks and theory units.</p>
        </div>
        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 mt-4 inline-block">Go to Home →</span>
      </a>

      <a href="/simulator" class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:border-emerald-500 transition group flex flex-col justify-between">
        <div>
          <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400">Practice</span>
          <h3 class="font-bold text-slate-900 dark:text-white text-sm mt-1 group-hover:text-emerald-600 transition">
            Online Mock Exam
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Practice the official 80-mark computerized test.</p>
        </div>
        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 mt-4 inline-block">Launch Exam →</span>
      </a>

      <a href="https://ebooks.ebalbharati.in/pdfs/1203010499.pdf" target="_blank" rel="noopener noreferrer" class="p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm hover:border-emerald-500 transition group flex flex-col justify-between">
        <div>
          <span class="text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400">Balbharati</span>
          <h3 class="font-bold text-slate-900 dark:text-white text-sm mt-1 group-hover:text-emerald-600 transition">
            12th IT Textbook
          </h3>
          <p class="text-xs text-slate-500 dark:text-slate-400 mt-1">Download official state board textbook PDF.</p>
        </div>
        <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400 mt-4 inline-block">Open PDF ↗</span>
      </a>

    </div>

    <!-- Quick Help Text -->
    <p class="text-xs text-slate-500 dark:text-slate-400">
      Need a specific Board Practicals or past question paper? Check the main menu navigation above.
    </p>
  </section>
</PortalLayout>