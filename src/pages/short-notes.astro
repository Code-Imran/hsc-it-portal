---
import PortalLayout from "../layouts/PortalLayout.astro";
import notes from '../short-notes.json';
---

<PortalLayout title="HSC IT Short Notes (Q7 - 4 Marks) | HSC IT Portal">
  <main class="max-w-3xl mx-auto py-8 px-4 sm:px-6 space-y-6">
    
    <a href="/" class="inline-flex items-center gap-1.5 text-xs font-mono font-bold text-emerald-600 dark:text-emerald-400 hover:underline">
      ← Back to Portal Home
    </a>

    <div class="border-b border-slate-200 dark:border-slate-800 pb-4">
      <span class="text-xs font-mono font-bold px-2.5 py-1 rounded bg-emerald-100 text-emerald-800 dark:bg-emerald-950 dark:text-emerald-300">
        Board Exam Q7 (8 Marks Total)
      </span>
      <h1 class="text-2xl sm:text-3xl font-black mt-3 text-slate-900 dark:text-white">HSC IT Short Notes Bank</h1>
      <p class="text-sm text-slate-600 dark:text-slate-400 mt-1">
        Point-by-point model answers designed for the 4-mark criteria (Answer 2 of 4).
      </p>
    </div>

    <div class="space-y-4">
      {notes.map((item, idx) => (
        <article id="{item.slug}" class="scroll-mt-6 p-5 rounded-2xl border border-slate-200 dark:border-slate-800 bg-white dark:bg-slate-900 shadow-sm space-y-3">
          <div class="flex items-center justify-between gap-2">
            <span class="text-xs font-mono font-bold text-slate-400">Q{idx + 1} • {item.chapter}</span>
            <span class="text-xs font-bold text-emerald-600 dark:text-emerald-400">{item.marks} Marks Target</span>
          </div>
          <h2 class="text-base sm:text-lg font-bold text-slate-900 dark:text-white leading-snug">
            {item.question}
          </h2>
          <ul class="space-y-2 pt-2 border-t border-slate-100 dark:border-slate-800">
            {item.points.map((pt, pIdx) => (
              <li class="flex items-start gap-2.5 text-xs sm:text-sm text-slate-700 dark:text-slate-300 leading-relaxed">
                <span class="shrink-0 mt-1 h-2 w-2 rounded-full bg-emerald-500"></span>
                <span><strong class="text-slate-900 dark:text-slate-100">Point {pIdx + 1}:</strong> {pt}</span>
              </li>
            ))}
          </ul>
        </article>
      ))}
    </div>

  </main>
</PortalLayout>