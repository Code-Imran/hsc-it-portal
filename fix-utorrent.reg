Windows Registry Editor Version 5.00; 1. Register .torrent file association[HKEY_CURRENT_USER\Software\Classes.torrent]@="uTorrent"[HKEY_CURRENT_USER\Software\Classes\uTorrent]@="Torrent File"[HKEY_CURRENT_USER\Software\Classes\uTorrent\DefaultIcon]@=""C:\Users\YNetDefenders\AppData\Roaming\uTorrent\uTorrent.exe",0"[HKEY_CURRENT_USER\Software\Classes\uTorrent\shell\open\command]@=""C:\Users\NetDefenders\AppData\Roaming\uTorrent\uTorrent.exe" "%1""; 2. Register magnet: protocol handler[HKEY_CURRENT_USER\Software\Classes\magnet]@="URL:Magnet URI""URL Protocol"=""[HKEY_CURRENT_USER\Software\Classes\magnet\DefaultIcon]@=""C:\Users\NetDefenders\AppData\Roaming\uTorrent\uTorrent.exe",0"[HKEY_CURRENT_USER\Software\Classes\magnet\shell\open\command]@=""C:\Users\NetDefenders\AppData\Roaming\uTorrent\uTorrent.exe" "%1""; 3. Register uTorrent in Windows 11 Default Apps[HKEY_CURRENT_USER\Software\uTorrent\Capabilities]"ApplicationDescription"="uTorrent BitTorrent Client""ApplicationName"="uTorrent"[HKEY_CURRENT_USER\Software\uTorrent\Capabilities\FileAssociations]".torrent"="uTorrent"[HKEY_CURRENT_USER\Software\uTorrent\Capabilities\URLAssociations]"magnet"="magnet"[HKEY_CURRENT_USER\Software\RegisteredApplications]"uTorrent"="Software\uTorrent\Capabilities"